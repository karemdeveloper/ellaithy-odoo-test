<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ibs_hr_admin_penalty_view_list" model="ir.ui.view">
        <field name="name">ibs.hr.admin.penalty.list</field>
        <field name="model">ibs.hr.admin.penalty</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="cost"/><field name="record_count"/></list></field>
    </record>
    <record id="ibs_hr_admin_penalty_view_form" model="ir.ui.view">
        <field name="name">ibs.hr.admin.penalty.form</field>
        <field name="model">ibs.hr.admin.penalty</field>
        <field name="arch" type="xml">
            <form><sheet>
                <div class="oe_title"><h1><field name="name" placeholder="Penalty name"/></h1></div>
                <group>
                    <field name="cost"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="record_count"/>
                    <field name="active" invisible="1"/>
                </group>
            </sheet></form></field>
    </record>
    <record id="ibs_hr_admin_penalty_action" model="ir.actions.act_window">
        <field name="name">Admin Penalties List</field>
        <field name="res_model">ibs.hr.admin.penalty</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
