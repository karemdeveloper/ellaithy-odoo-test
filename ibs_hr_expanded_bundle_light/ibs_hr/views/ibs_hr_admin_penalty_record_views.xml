<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ibs_hr_admin_penalty_record_view_list" model="ir.ui.view">
        <field name="name">ibs.hr.admin.penalty.record.list</field>
        <field name="model">ibs.hr.admin.penalty.record</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="employee_id"/><field name="branch_id"/><field name="penalty_id"/><field name="date"/><field name="name_snapshot"/><field name="cost_snapshot"/><field name="custom_cost"/><field name="amount"/><field name="giver_id"/><field name="approval_status"/></list></field>
    </record>
    <record id="ibs_hr_admin_penalty_record_view_form" model="ir.ui.view">
        <field name="name">ibs.hr.admin.penalty.record.form</field>
        <field name="model">ibs.hr.admin.penalty.record</field>
        <field name="arch" type="xml">
            <form>
            <header>
                <!--
                    CR 2.13 / 2.14: one approval settles the penalty, and only
                    a member of the approver group sees the buttons. The model
                    enforces the same rule, so hiding them here is a courtesy
                    rather than the control.
                -->
                <field name="can_approve" invisible="1"/>
                <button name="action_approve" type="object" string="Approve" class="btn-primary"
                        invisible="approval_status != 'pending' or not can_approve"/>
                <button name="action_reject" type="object" string="Reject"
                        invisible="approval_status != 'pending' or not can_approve"/>
                <button name="action_cancel" type="object" string="Cancel"
                        invisible="approval_status not in ('pending', 'approved') or not can_approve"/>
                <button name="action_reset" type="object" string="Reset"
                        invisible="approval_status == 'pending' or not can_approve"/>
                <field name="approval_status" widget="statusbar"/>
            </header>
            <sheet>
                <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                <group>
                    <group>
                        <field name="employee_id"/><field name="branch_id"/>
                        <field name="penalty_id"/><field name="date"/><field name="execution_date"/>
                        <field name="giver_id"/>
                    </group>
                    <group>
                        <field name="name_snapshot"/><field name="cost_snapshot"/>
                        <field name="custom_cost"/><field name="amount"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="payslip_id"/>
                    </group>
                </group>
                <group string="Review">
                    <field name="approved_by"/><field name="approved_at"/>
                    <field name="rejected_by"/><field name="rejected_at"/>
                    <field name="rejection_reason"
                           placeholder="Reason -- required to reject or cancel"/>
                </group>
                <field name="notes" placeholder="Notes"/>
                <field name="attachment_ids" widget="many2many_binary"/>
            </sheet>
            <chatter/></form></field>
    </record>
    <record id="ibs_hr_admin_penalty_record_action" model="ir.actions.act_window">
        <field name="name">Admin Penalties</field>
        <field name="res_model">ibs.hr.admin.penalty.record</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
