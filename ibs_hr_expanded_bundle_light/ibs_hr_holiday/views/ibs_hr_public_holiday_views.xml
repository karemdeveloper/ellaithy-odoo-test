<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ibs_hr_public_holiday_view_list" model="ir.ui.view">
        <field name="name">ibs.hr.public.holiday.list</field>
        <field name="model">ibs.hr.public.holiday</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="ibs_hr_public_holiday_view_form" model="ir.ui.view">
        <field name="name">ibs.hr.public.holiday.form</field>
        <field name="model">ibs.hr.public.holiday</field>
        <field name="arch" type="xml">
            <form><sheet><group>
                <field name="name"/>
                <field name="date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" invisible="1"/>
            </group></sheet></form>
        </field>
    </record>
    <record id="ibs_hr_public_holiday_action" model="ir.actions.act_window">
        <field name="name">Public Holidays</field>
        <field name="res_model">ibs.hr.public.holiday</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

