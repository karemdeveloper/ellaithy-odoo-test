<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_ellithy_hr_user" model="res.groups">
        <field name="name">User (Employee)</field>
        <field name="category_id" ref="module_category_ellithy_hr"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_ellithy_hr_generalist" model="res.groups">
        <field name="name">HR Generalist</field>
        <field name="category_id" ref="module_category_ellithy_hr"/>
        <field name="implied_ids" eval="[(4, ref('group_ellithy_hr_user')), (4, ref('group_ellithy_hr_personnel'))]"/>
    </record>
    <record id="group_ellithy_financial_approval" model="res.groups">
        <field name="name">Financial Approval</field>
        <field name="category_id" ref="module_category_ellithy_hr"/>
        <field name="implied_ids" eval="[(4, ref('group_ellithy_hr_user'))]"/>
    </record>
    <!-- Run on both install and upgrade, including legacy noupdate groups. -->
    <function model="res.groups" name="_ellithy_apply_hcm_roles"/>
</odoo>
