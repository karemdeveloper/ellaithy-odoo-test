<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_ellithy_hr" model="ir.module.category">
            <field name="name">Ellithy HR</field>
            <field name="description">Access levels mirroring the seven legacy roles.</field>
            <field name="sequence">20</field>
        </record>

        <!-- Legacy roles: Employee, Assistant, Key assistant, HR personnel,
             Manager, Admin, Superadmin. Employee maps to base.group_user. -->
        <record id="group_ellithy_hr_assistant" model="res.groups">
            <field name="name">Assistant</field>
            <field name="category_id" ref="module_category_ellithy_hr"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_ellithy_hr_branch_manager" model="res.groups">
            <field name="name">Branch Manager</field>
            <field name="category_id" ref="module_category_ellithy_hr"/>
            <field name="implied_ids" eval="[(4, ref('group_ellithy_hr_assistant'))]"/>
        </record>

        <record id="group_ellithy_hr_personnel" model="res.groups">
            <field name="name">HR Personnel</field>
            <field name="category_id" ref="module_category_ellithy_hr"/>
            <field name="implied_ids" eval="[(4, ref('group_ellithy_hr_branch_manager')), (4, ref('hr.group_hr_user'))]"/>
        </record>

        <record id="group_ellithy_hr_admin" model="res.groups">
            <field name="name">HR Admin</field>
            <field name="category_id" ref="module_category_ellithy_hr"/>
            <field name="implied_ids" eval="[(4, ref('group_ellithy_hr_personnel')), (4, ref('hr.group_hr_manager'))]"/>
        </record>

        <!-- Branch scoping. A branch manager must not see other branches,
             and the rule has to hold on export and JSON-RPC too, which is why
             it is a record rule rather than a hidden menu. -->
        <record id="rule_hr_employee_branch" model="ir.rule">
            <field name="name">Employee: own branch only</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">[('branch_id', '=', user.employee_id.branch_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_ellithy_hr_branch_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hr_employee_all_branches" model="ir.rule">
            <field name="name">Employee: all branches</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ellithy_hr_personnel'))]"/>
        </record>

        <record id="rule_ellithy_hr_account_hr" model="ir.rule">
            <field name="name">Payout account: HR sees all</field>
            <field name="model_id" ref="model_ellithy_hr_account"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ellithy_hr_personnel'))]"/>
        </record>

        <record id="rule_ellithy_hr_account_own" model="ir.rule">
            <field name="name">Payout account: HR only</field>
            <field name="model_id" ref="model_ellithy_hr_account"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
