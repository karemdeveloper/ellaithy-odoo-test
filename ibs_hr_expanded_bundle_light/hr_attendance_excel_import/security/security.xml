<odoo>
    <data noupdate="1">
        <!-- Server-side Python addon: install from addons_path, not Import Module ZIP.
             Keep this declaration empty: revision defaults on create and must
             never be reset when XML is replayed during installation/upgrade. -->
        <record id="serialization_guard" model="hr.attendance.excel.import.lock"/>
    </data>
    <record id="import_company_rule" model="ir.rule">
        <field name="name">Attendance import company scope</field>
        <field name="model_id" ref="model_hr_attendance_excel_import"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="import_line_company_rule" model="ir.rule">
        <field name="name">Attendance import row company scope</field>
        <field name="model_id" ref="model_hr_attendance_excel_import_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="import_wizard_company_rule" model="ir.rule">
        <field name="name">Attendance upload company scope</field>
        <field name="model_id" ref="model_hr_attendance_excel_import_wizard"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
