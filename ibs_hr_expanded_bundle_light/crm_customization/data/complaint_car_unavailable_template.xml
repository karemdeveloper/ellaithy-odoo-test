<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Car Unavailable After Agreement Complaint Email Template (Arabic) -->
    <record id="email_template_complaint_car_unavailable"
            model="mail.template">
        <field name="name">Complaint: Car Unavailable After Agreement (Arabic)</field>
        <field name="model_id"
               ref="model_res_complaint"/>
        <field name="subject"> {{ object.name }} ,شكوي عدم توافر فئة سيارة</field>
        <field name="email_from">{{(object.create_uid.email_formatted or user.email_formatted) or ''}}</field>
        <field name="body_html"
               type="html">
            <div style="margin: 0px; padding: 0px; direction: rtl; text-align: right; font-family: Arial, sans-serif;">
                <t t-if="object.complaint_state == 'solved'">
                    <p style="color: green; font-weight: bold;">
                        ✅ تم حل الشكوى
                    </p>
                </t>
                <p style="font-size: 14px; margin-bottom: 10px;">
                    <strong>رقم الشكوى:</strong>
                    <t t-esc="object.name"/>
                </p>
                <p style="font-size: 14px; margin-bottom: 15px;">
                    استاذ /
                    <t t-out="object.department.department_manager_id.name or 'Department Manager'"/>
                    <br/>
                    <br/>
                    تحية طيبة وبعد ,,,
                </p>

                <p style="margin: 10px 0px; padding: 0px; font-size: 14px; line-height: 1.8;">
                    وردنا اتصال من العميل لاحق الذكر يشكو من انه بعد اتمام الاتفاق مع استاذ                    <strong>
                    {{object.salesperson_id.name or 'مسئول مبيعات'}}
                </strong> علي سيارة اخبره مسئول المبيعات بعدم توافر السيارة مما ادي الي استياء العميل
                    <br/>
                    <br/>
                    <strong style="color: #d32f2f;">فبرجاء التواصل مع العميل وافادتنا باخر المستجدات.</strong>
                </p>

                <div style="background-color: #ffebee; padding: 15px; border-right: 3px solid #f44336; margin: 15px 0; border-radius: 4px;">
                    <p style="margin: 0 0 10px 0; font-size: 14px; color: #c62828; font-weight: bold;">
                        ⚠️ المشكلة:
                    </p>
                    <p style="margin: 5px 0; padding-right: 10px; font-size: 13px; color: #d32f2f;">
                        تم الاتفاق مع العميل على سيارة محددة ثم إخباره بعدم التوافر - هذا يؤثر سلباً على مصداقية الشركة
                    </p>
                </div>

                <div style="background-color: #e8f5e9; padding: 15px; border-right: 3px solid #4caf50; margin: 15px 0; border-radius: 4px;">
                    <p style="margin: 0 0 10px 0; font-size: 14px; color: #2e7d32; font-weight: bold;">
                        ✅ الإجراءات المطلوبة:
                    </p>
                    <ul style="margin: 5px 0; padding-right: 20px; font-size: 13px; color: #1b5e20;">
                        <li style="margin: 5px 0;">التواصل الفوري مع العميل</li>
                        <li style="margin: 5px 0;">الاعتذار عن سوء الفهم</li>
                        <li style="margin: 5px 0;">توضيح الموقف الحقيقي للسيارة</li>
                        <li style="margin: 5px 0;">تقديم بدائل مناسبة للعميل</li>
                        <li style="margin: 5px 0;">العمل على استعادة ثقة العميل</li>
                        <li style="margin: 5px 0;">إبلاغنا بنتائج المتابعة</li>
                    </ul>
                </div>

                <div style="background-color: #fff8e1; padding: 12px; border-right: 3px solid #ffc107; margin: 15px 0; border-radius: 4px;">
                    <p style="margin: 0; font-size: 13px; color: #f57c00;">
                        <strong>📌 هام:</strong>
                        يجب التأكد من توافر السيارات قبل الاتفاق مع العملاء لتجنب هذه المواقف
                    </p>
                </div>

                <p style="margin: 20px 0px 10px 0px; padding: 0px; font-size: 14px; font-weight: bold; color: #ff9800;">
                    🔶 يرجى التواصل مع العميل فوراً وتقديم حلول بديلة مناسبة
                </p>

                <div style="margin: 20px 0px; text-align: center;">
                    <a href="/web#id={{object.id}}&amp;model=res.complaint&amp;view_type=form"
                       style="padding: 10px 20px; font-size: 14px; color: #FFFFFF; background-color: #ff9800; border: none; border-radius: 4px; text-decoration: none; display: inline-block; font-weight: bold;">
                        عرض تفاصيل الشكوى
                    </a>
                </div>

                <p style="margin: 20px 0px 0px 0px; padding: 0px; font-size: 13px; color: #666;">
                    مع خالص التحية والتقدير،
                    <br/>
                    <t t-esc="object.create_uid.name or 'نظام إدارة الشكاوى'"/>
                </p>

                <hr style="border: none; border-top: 1px solid #e0e0e0; margin: 20px 0;"/>

                <p style="margin: 0px; padding: 0px; font-size: 11px; color: #999; text-align: center;">
                    هذه رسالة تلقائية من نظام إدارة الشكاوى - يرجى عدم الرد على هذا البريد مباشرة
                </p>
            </div>
        </field>
        <field name="auto_delete"
               eval="False"/>
    </record>
</odoo>
