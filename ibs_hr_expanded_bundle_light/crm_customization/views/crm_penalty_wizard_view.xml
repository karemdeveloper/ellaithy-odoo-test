<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_crm_penalty_wizard_form" model="ir.ui.view">
        <field name="name">crm.penalty.wizard.form</field>
        <field name="model">crm.penalty.wizard</field>
        <field name="arch" type="xml">
            <form string="Penalty Report">
                <group>
                    <field name="branch_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_print_report" type="object" string="Print" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_crm_penalty_wizard" model="ir.actions.act_window">
        <field name="name">Penalties</field>
        <field name="res_model">crm.penalty.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu item -->
    <menuitem id="menu_crm_penalty_report"
              name="Penalties"
              parent="crm.crm_menu_report"
              action="action_crm_penalty_wizard"
              sequence="50"/>
</odoo>
