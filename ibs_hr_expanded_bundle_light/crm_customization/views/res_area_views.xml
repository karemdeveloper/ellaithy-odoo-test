<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =================== AREA =================== -->
    <record id="view_res_area_list" model="ir.ui.view">
        <field name="name">res.area.list</field>
        <field name="model">res.area</field>
        <field name="arch" type="xml">
            <list>
                <field name="area_name"/>
                <field name="name_ar"/>
                <field name="branch_area"/>
            </list>
        </field>
    </record>

    <record id="view_res_area_form" model="ir.ui.view">
        <field name="name">res.area.form</field>
        <field name="model">res.area</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="area_name"/>
                        <field name="name_ar"/>
                        <field name="branch_area"/>
                    </group>
                </sheet>
                <!-- Attachment preview -->
                <div class="o_attachment_preview" />
                <!-- Chatter -->
                <chatter reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <record id="action_res_area" model="ir.actions.act_window">
        <field name="name">Area</field>
        <field name="res_model">res.area</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_res_area"
              name="Areas"
              parent="crm.crm_menu_config"
              action="action_res_area"
              sequence="2"/>


</odoo>