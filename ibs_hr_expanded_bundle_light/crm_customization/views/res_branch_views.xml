<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =================== BRANCH =================== -->
    <record id="view_res_branch_list" model="ir.ui.view">
        <field name="name">res.branch.list</field>
        <field name="model">res.branch</field>
        <field name="arch" type="xml">
            <list>
                <field name="branch_name"/>
                <field name="branch_manager"/>
            </list>
        </field>
    </record>

    <record id="view_res_branch_form" model="ir.ui.view">
        <field name="name">res.branch.form</field>
        <field name="model">res.branch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                    <group>
                        <field name="branch_name" required="1"/>
                        <field name="branch_code" required="1"/>
                    </group>
                         <group>
                        <field name="branch_manager" required="1"/>
                    </group>
                    </group>
                </sheet>
                 <!-- Attachment preview -->
                    <div class="o_attachment_preview" />
                    <!-- Chatter -->
                    <chatter reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <record id="action_res_branch" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">res.branch</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_res_branch"
              name="Branches"
              parent="crm.crm_menu_config"
              action="action_res_branch"
              sequence="1"/>
</odoo>