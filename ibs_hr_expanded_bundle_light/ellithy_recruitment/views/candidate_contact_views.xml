<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="candidate_contact_view_list" model="ir.ui.view">
        <field name="name">ellithy.candidate.contact.list</field>
        <field name="model">ellithy.candidate.contact</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="date"/>
                <field name="candidate_id"/>
                <field name="channel"/>
                <field name="job_id" optional="show"/>
                <field name="result"/>
                <field name="notes"/>
                <field name="follow_up_date"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
            </list>
        </field>
    </record>

    <record id="candidate_contact_view_search" model="ir.ui.view">
        <field name="name">ellithy.candidate.contact.search</field>
        <field name="model">ellithy.candidate.contact</field>
        <field name="arch" type="xml">
            <search>
                <field name="candidate_id"/>
                <field name="job_id"/>
                <filter name="whatsapp" string="WhatsApp" domain="[('channel', '=', 'whatsapp')]"/>
                <filter name="phone" string="Phone" domain="[('channel', '=', 'phone')]"/>
                <filter name="to_follow" string="Follow-up Due" domain="[('follow_up_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_result" string="Result" context="{'group_by': 'result'}"/>
                    <filter name="group_channel" string="Channel" context="{'group_by': 'channel'}"/>
                    <filter name="group_user" string="Contacted By" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_candidate_contact" model="ir.actions.act_window">
        <field name="name">Contact Log</field>
        <field name="res_model">ellithy.candidate.contact</field>
        <field name="view_mode">list,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Log a call or WhatsApp with a candidate</p>
            <p>Works with or without an application; a follow-up date schedules a reminder.</p>
        </field>
    </record>
</odoo>
