        <field name="name">Time Off Type: allowed companies</field>
        <field name="model_id" ref="model_ibs_hr_time_off_type"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
