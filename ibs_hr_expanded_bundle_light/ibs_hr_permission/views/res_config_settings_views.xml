<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ibs.hr.permission</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr']" position="inside">
                <block title="Permissions" name="ibs_hr_permission_settings_container"
                       groups="ibs_hr_permission.permission_admin">
                    <setting string="Monthly Permission Cap"
                             help="Total permission minutes an employee may be granted per calendar month.">
                        <field name="ibs_hr_permission_monthly_cap_minutes"/> minutes
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
