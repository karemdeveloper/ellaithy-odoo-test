<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_resignation_clearance_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.resignation.clearance.wizard.form</field>
        <field name="model">hr.resignation.clearance.wizard</field>
        <field name="arch" type="xml">
            <form string="Start Clearance">
                <div class="alert alert-info" role="status">
                    Confirming the last working day writes it back to the
                    resignation. The direct manager and every department below
                    get their own line and an email at the same time; they may
                    sign in any order, and all of them must sign before
                    clearance can be confirmed.
                </div>
                <group>
                    <group>
                        <field name="resignation_id" invisible="1"/>
                        <field name="employee_id" readonly="1"/>
                        <field name="employee_department_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="last_working_day"/>
                    </group>
                </group>
                <group string="Who Has to Sign">
                    <field name="include_direct_manager"/>
                    <field name="direct_manager_id" readonly="1"
                           invisible="not include_direct_manager"/>
                    <div colspan="2" class="text-warning"
                         invisible="not include_direct_manager or direct_manager_id">
                        This employee has no manager set, so no direct-manager
                        line will be added.
                    </div>
                    <field name="department_ids"
                           widget="many2many_tags"
                           options="{'no_create': True}"
                           placeholder="IT, Finance, Stores, Fleet..."/>
                </group>
                <group string="Instructions">
                    <field name="note" nolabel="1"
                           placeholder="Anything the departments should know before signing"/>
                </group>
                <footer>
                    <button name="action_start_clearance" type="object"
                            string="Start Clearance" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
