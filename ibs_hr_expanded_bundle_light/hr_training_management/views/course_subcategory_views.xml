<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_course_subcategory_list" model="ir.ui.view">
        <field name="name">course.subcategory.list</field>
        <field name="model">course.subcategory</field>
        <field name="arch" type="xml">
            <list>
                <field name="image" widget="image" options="{'size': [40, 40]}"/>
                <field name="name"/>
                <field name="category_id"/>
            </list>
        </field>
    </record>

    <record id="view_course_subcategory_form" model="ir.ui.view">
        <field name="name">course.subcategory.form</field>
        <field name="model">course.subcategory</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <field name="active" invisible="1"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="category_id"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_course_subcategory_kanban" model="ir.ui.view">
        <field name="name">course.subcategory.kanban</field>
        <field name="model">course.subcategory</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="image"/>
                <field name="category_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <img t-att-src="kanban_image('course.subcategory', 'image', record.id.raw_value)"
                                 class="o_kanban_image_fill_left rounded" alt="Subcategory" width="48" height="48"/>
                            <strong><field name="name"/></strong>
                            <div class="text-muted"><field name="category_id"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_course_subcategory_search" model="ir.ui.view">
        <field name="name">course.subcategory.search</field>
        <field name="model">course.subcategory</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_course_subcategory" model="ir.actions.act_window">
        <field name="name">Course Subcategories</field>
        <field name="res_model">course.subcategory</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_group_category': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first course subcategory
            </p>
        </field>
    </record>

    <menuitem id="menu_course_subcategory" name="Subcategories" parent="menu_course_config"
              action="action_course_subcategory" sequence="20"/>

</odoo>
