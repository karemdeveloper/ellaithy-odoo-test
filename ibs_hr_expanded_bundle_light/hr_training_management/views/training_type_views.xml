<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_training_type_list" model="ir.ui.view">
        <field name="name">training.type.list</field>
        <field name="model">training.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_training_type_form" model="ir.ui.view">
        <field name="name">training.type.form</field>
        <field name="model">training.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_training_type_search" model="ir.ui.view">
        <field name="name">training.type.search</field>
        <field name="model">training.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_training_type" model="ir.actions.act_window">
        <field name="name">Training Types</field>
        <field name="res_model">training.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_training_root" name="Training" sequence="75"/>
    <menuitem id="menu_training_config" name="Configuration" parent="menu_training_root" sequence="100"/>
    <menuitem id="menu_training_type" name="Training Types" parent="menu_training_config"
              action="action_training_type" sequence="10"/>

</odoo>
