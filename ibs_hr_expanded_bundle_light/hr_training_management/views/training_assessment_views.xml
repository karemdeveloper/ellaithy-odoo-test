<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_training_assessment_list" model="ir.ui.view">
        <field name="name">training.assessment.list</field>
        <field name="model">training.assessment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="training_id"/>
                <field name="total_marks"/>
                <field name="pass_mark"/>
                <field name="attempt_count" string="Trainees"/>
                <field name="pass_count" string="Passed"/>
                <field name="state" widget="badge" decoration-success="state == 'published'"/>
            </list>
        </field>
    </record>

    <record id="view_training_assessment_form" model="ir.ui.view">
        <field name="name">training.assessment.form</field>
        <field name="model">training.assessment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_publish" type="object" string="Open Assessment"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_send_to_trainees" type="object" string="Send to Trainees"
                            class="btn-primary" invisible="state != 'published'"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'published'"/>
                    <button name="action_reset_draft" type="object" string="Back to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_attempts" type="object"
                                class="oe_stat_button" icon="fa-check-square-o">
                            <field name="attempt_count" widget="statinfo" string="Results"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Sales Basics - Final Test"/></h1></div>
                    <group>
                        <group>
                            <field name="training_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="total_marks" decoration-danger="total_marks != 100"
                                   decoration-success="total_marks == 100"/>
                            <field name="pass_mark"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status" invisible="state != 'draft'">
                        Questions must add up to 100 marks. Multiple-choice answers are
                        marked automatically; essay answers are marked by hand on each
                        trainee's result.
                    </div>
                    <notebook>
                        <page string="Questions" name="questions">
                            <field name="question_ids" readonly="state != 'draft'">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="question_type"/>
                                    <field name="name"/>
                                    <field name="marks" sum="Total"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="question_type"/>
                                            <field name="marks"/>
                                        </group>
                                    </group>
                                    <field name="name" placeholder="Question text"/>
                                    <field name="option_ids" invisible="question_type != 'mcq'">
                                        <list editable="bottom">
                                            <field name="sequence" widget="handle"/>
                                            <field name="name"/>
                                            <field name="is_correct"/>
                                        </list>
                                    </field>
                                </form>
                            </field>
                        </page>
                        <page string="Instructions" name="instructions">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_training_assessment" model="ir.actions.act_window">
        <field name="name">Assessments</field>
        <field name="res_model">training.assessment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a test for a training</p>
            <p>Multiple-choice and essay questions out of 100, pass mark 70.</p>
        </field>
    </record>

    <record id="view_training_assessment_attempt_list" model="ir.ui.view">
        <field name="name">training.assessment.attempt.list</field>
        <field name="model">training.assessment.attempt</field>
        <field name="arch" type="xml">
            <list create="false" decoration-success="result == 'pass'" decoration-danger="result == 'fail'">
                <field name="employee_id"/>
                <field name="assessment_id"/>
                <field name="training_id" optional="show"/>
                <field name="state" widget="badge" decoration-warning="state == 'submitted'"
                       decoration-success="state == 'graded'"/>
                <field name="auto_score" optional="show"/>
                <field name="manual_score" optional="show"/>
                <field name="score"/>
                <field name="result"/>
                <field name="submitted_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_training_assessment_attempt_form" model="ir.ui.view">
        <field name="name">training.assessment.attempt.form</field>
        <field name="model">training.assessment.attempt</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send_invitation" type="object" string="Send Link"
                            invisible="state != 'draft'"/>
                    <button name="action_submit" type="object" string="Submit Answers"
                            invisible="state != 'draft'"
                            confirm="Lock these answers and mark the multiple-choice part?"/>
                    <button name="action_finish_marking" type="object" string="Finish Marking"
                            class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_reopen" type="object" string="Re-mark"
                            invisible="state != 'graded'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Pass" bg_color="text-bg-success" invisible="result != 'pass'"/>
                    <widget name="web_ribbon" title="Fail" bg_color="text-bg-danger" invisible="result != 'fail'"/>
                    <group>
                        <group>
                            <field name="employee_id" readonly="1"/>
                            <field name="assessment_id" readonly="1"/>
                            <field name="training_id"/>
                        </group>
                        <group>
                            <field name="auto_score"/>
                            <field name="manual_score"/>
                            <field name="score"/>
                            <field name="pass_mark"/>
                            <field name="result"/>
                        </group>
                    </group>
                    <div class="text-muted" invisible="state != 'draft'">
                        Trainee link: <field name="access_token" invisible="1"/>
                        the trainee answers from the emailed link, or type a paper test's answers below and press Submit Answers.
                    </div>
                    <field name="answer_ids">
                        <list editable="bottom" create="false" delete="false">
                            <field name="sequence" column_invisible="1"/>
                            <field name="question_id" readonly="1"/>
                            <field name="question_type" readonly="1"/>
                            <field name="option_id" readonly="parent.state != 'draft' or question_type != 'mcq'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="essay_answer" readonly="parent.state != 'draft' or question_type != 'essay'"/>
                            <field name="is_correct" readonly="1"/>
                            <field name="question_marks"/>
                            <field name="marks_awarded"
                                   readonly="question_type != 'essay' or parent.state != 'submitted'"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_training_assessment_attempt_search" model="ir.ui.view">
        <field name="name">training.assessment.attempt.search</field>
        <field name="model">training.assessment.attempt</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="assessment_id"/>
                <filter name="to_mark" string="Awaiting Marking" domain="[('state', '=', 'submitted')]"/>
                <filter name="passed" string="Passed" domain="[('result', '=', 'pass')]"/>
                <filter name="failed" string="Failed" domain="[('result', '=', 'fail')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_assessment" string="Assessment" context="{'group_by': 'assessment_id'}"/>
                    <filter name="group_result" string="Result" context="{'group_by': 'result'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_training_assessment_attempt" model="ir.actions.act_window">
        <field name="name">Assessment Results</field>
        <field name="res_model">training.assessment.attempt</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="context">{'search_default_to_mark': 0}</field>
    </record>

    <menuitem id="menu_training_assessment_root" name="Assessments"
              parent="menu_training_root" sequence="20"/>
    <menuitem id="menu_training_assessment" name="Assessments"
              parent="menu_training_assessment_root" action="action_training_assessment" sequence="10"/>
    <menuitem id="menu_training_assessment_attempt" name="Results"
              parent="menu_training_assessment_root" action="action_training_assessment_attempt" sequence="20"/>

    <!-- Training history on the employee file -->
    <record id="hr_employee_view_form_training" model="ir.ui.view">
        <field name="name">hr.employee.form.training</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_training_history" type="object"
                        class="oe_stat_button" icon="fa-graduation-cap"
                        groups="hr.group_hr_user">
                    <field name="training_count" widget="statinfo" string="Trainings"/>
                </button>
            </div>
            <!-- HR letter item 7: the training record on the employee file -->
            <notebook position="inside">
                <page string="Training" name="training_history" groups="hr.group_hr_user">
                    <field name="training_participant_ids" readonly="1" nolabel="1">
                        <list default_order="date_start desc">
                            <field name="training_id"/>
                            <field name="training_type_id"/>
                            <field name="trainer_id" optional="show"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="attended_count" string="Attended"/>
                            <field name="session_count" string="Sessions"/>
                            <field name="attendance_rate" widget="progressbar"/>
                            <field name="assessment_score"/>
                            <field name="assessment_result" widget="badge"
                                   decoration-success="assessment_result == 'pass'"
                                   decoration-danger="assessment_result == 'fail'"
                                   decoration-warning="assessment_result == 'pending'"/>
                            <field name="evaluation_score" optional="show"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
