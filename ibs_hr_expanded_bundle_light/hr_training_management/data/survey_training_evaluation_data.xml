            <field name="question_type">simple_choice</field>
            <field name="training_eval_part">training</field>
            <field name="constr_mandatory" eval="True"/>
        </record>
        <record id="training_eval_question_content_1" model="survey.question.answer">
            <field name="question_id" ref="training_eval_question_content"/>
            <field name="sequence">1</field>
            <field name="value">1 - Poor / ضعيف</field>
            <field name="answer_score">1</field>
        </record>
        <record id="training_eval_question_content_2" model="survey.question.answer">
            <field name="question_id" ref="training_eval_question_content"/>
            <field name="sequence">2</field>
            <field name="value">2 - Fair / مقبول</field>
            <field name="answer_score">2</field>
        </record>
        <record id="training_eval_question_content_3" model="survey.question.answer">
