<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        HR letter item 8: the trainees rate the training and the trainer from
        1 to 5 through a token link mailed when the programme ends. Each
        question is tagged Training or Trainer so the two ratings are kept
        apart; the overall result is the survey's own percentage. noupdate,
        so HR can reword questions in Surveys without an upgrade undoing it.
    -->
    <data noupdate="1">
        <record id="survey_training_evaluation" model="survey.survey">
            <field name="title">Training &amp; Trainer Evaluation / تقييم التدريب والمدرب</field>
            <field name="survey_type">custom</field>
            <field name="access_mode">token</field>
            <field name="users_login_required" eval="False"/>
            <field name="users_can_go_back" eval="True"/>
            <field name="questions_layout">one_page</field>
            <field name="scoring_type">scoring_without_answers</field>
            <field name="scoring_success_min">60</field>
            <field name="is_hr_evaluation" eval="True"/>
            <field name="is_attempts_limited" eval="True"/>
            <field name="attempts_limit">1</field>
            <field name="description" type="html">
<p>Please rate the training and the trainer from 1 (poor) to 5 (outstanding).</p>
<p dir="rtl">برجاء تقييم البرنامج التدريبي والمدرب من 1 (ضعيف) إلى 5 (ممتاز).</p></field>
            <field name="description_done" type="html">
<p>Thank you. Your evaluation has been recorded.</p>
<p dir="rtl">شكرًا لك، تم تسجيل تقييمك.</p></field>
        </record>

        <record id="training_eval_question_content" model="survey.question">
            <field name="survey_id" ref="survey_training_evaluation"/>
            <field name="sequence">1</field>
