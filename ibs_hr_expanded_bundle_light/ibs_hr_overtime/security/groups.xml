<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ibs_hr_overtime_category" model="ir.module.category"><field name="name">Overtime</field><field name="sequence">25</field></record>
    <record id="ibs_hr_overtime_user" model="res.groups">
        <field name="name">User (Employee)</field>
        <field name="category_id" ref="ibs_hr_overtime_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="ellithy_hr_base.group_ellithy_hr_user" model="res.groups"><field name="implied_ids" eval="[(4, ref('ibs_hr_overtime_user'))]"/></record>
    <record id="ibs_hr_overtime_generalist" model="res.groups">
        <field name="name">HR Generalist</field>
        <field name="category_id" ref="ibs_hr_overtime_category"/>
        <field name="implied_ids" eval="[(4, ref('ibs_hr_overtime.ibs_hr_overtime_user')), (4, ref('hr.group_hr_user'))]"/>
    </record>
    <record id="ellithy_hr_base.group_ellithy_hr_generalist" model="res.groups"><field name="implied_ids" eval="[(4, ref('ibs_hr_overtime_generalist'))]"/></record>
    <record id="ibs_hr_overtime_finance" model="res.groups">
        <field name="name">Financial Approval</field>
        <field name="category_id" ref="ibs_hr_overtime_category"/>
        <field name="implied_ids" eval="[(4, ref('ibs_hr_overtime.ibs_hr_overtime_user'))]"/>
    </record>
    <record id="ellithy_hr_base.group_ellithy_financial_approval" model="res.groups"><field name="implied_ids" eval="[(4, ref('ibs_hr_overtime_finance'))]"/></record>
    <record id="ibs_hr_overtime_admin" model="res.groups">
        <field name="name">HR Admin</field>
        <field name="category_id" ref="ibs_hr_overtime_category"/>
        <field name="implied_ids" eval="[(4, ref('ibs_hr_overtime.ibs_hr_overtime_generalist')), (4, ref('ibs_hr_overtime.ibs_hr_overtime_finance'))]"/>
    </record>
    <record id="ellithy_hr_base.group_ellithy_hr_admin" model="res.groups"><field name="implied_ids" eval="[(4, ref('ibs_hr_overtime_admin'))]"/></record>
    <function model="res.groups" name="_ellithy_bind_module_roles">
        <value eval="'ibs_hr_overtime'"/>
        <value eval="'ibs_hr_overtime'"/>
        <value eval="True"/>
    </function>
</odoo>
