<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_bradford_company" model="ir.rule">
        <field name="name">Leave report: company boundary</field>
        <field name="model_id" ref="model_hr_employee_broad_factor"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bradford_employee" model="ir.rule">
        <field name="name">Leave report: own record</field>
        <field name="model_id" ref="model_hr_employee_broad_factor"/>
        <field name="domain_force">[('id', '=', user.employee_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_bradford_hr" model="ir.rule">
        <field name="name">Leave report: HR companies</field>
        <field name="model_id" ref="model_hr_employee_broad_factor"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('ibs_hr_time_off.ibs_hr_time_off_generalist'))]"/>
    </record>
</odoo>
