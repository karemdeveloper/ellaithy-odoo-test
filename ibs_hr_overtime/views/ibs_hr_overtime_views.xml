<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ibs_hr_overtime_view_list" model="ir.ui.view">
        <field name="name">ibs.hr.overtime.list</field>
        <field name="model">ibs.hr.overtime</field>
        <field name="arch" type="xml">
            <list><field name="date"/><field name="employee_id"/>
                <field name="candidate_minutes"/><field name="payable_minutes"/>
                <field name="compensation"/><field name="amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="ibs_hr_overtime_view_form" model="ir.ui.view">
        <field name="name">ibs.hr.overtime.form</field>
        <field name="model">ibs.hr.overtime</field>
        <field name="arch" type="xml">
            <form><header>
                <button name="action_manager_approve" type="object"
                        string="HR Approve" class="btn-primary"
                        invisible="state != 'draft'"
                        groups="ibs_hr_overtime.ibs_hr_overtime_generalist"/>
                <button name="action_hr_approve" type="object"
                        string="Finance Approve" class="btn-primary"
                        invisible="state != 'manager_approved'"
                        groups="ibs_hr_overtime.ibs_hr_overtime_finance"/>
                <button name="action_reject" type="object" string="Reject"
                        invisible="state not in ('draft', 'manager_approved')"/>
                <field name="state" widget="statusbar"
                       statusbar_visible="draft,manager_approved,approved,paid"/>
            </header><sheet><group>
                <field name="employee_id" readonly="1"/>
                <field name="attendance_day_id" readonly="1"/>
                <field name="date" readonly="1"/>
                <field name="candidate_minutes" readonly="1"/>
                <field name="payable_minutes" readonly="1"/>
                <field name="rest_eligible" readonly="1"/>
                <field name="hourly_rate" readonly="1"/>
                <field name="multiplier" readonly="state != 'draft'"/>
                <field name="compensation" readonly="state != 'draft'"/>
                <field name="amount" readonly="1"/>
                <field name="rest_credit_id" readonly="1"/>
                <field name="rejection_reason"/>
            </group></sheet><chatter/></form>
        </field>
    </record>
    <record id="ibs_hr_overtime_action" model="ir.actions.act_window">
        <field name="name">Overtime</field>
        <field name="res_model">ibs.hr.overtime</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
