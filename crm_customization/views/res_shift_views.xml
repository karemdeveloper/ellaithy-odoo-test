<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =================== SHIFTS =================== -->
    <record id="view_res_shift_list" model="ir.ui.view">
        <field name="name">res.shift.list</field>
        <field name="model">res.shift</field>
        <field name="arch" type="xml">
            <list>
                <field name="shift_name"/>
                <field name="day" column_invisible="1"/>
                <field name="from_date" widget="float_time"/>
                <field name="to_date" widget="float_time"/>
            </list>
        </field>
    </record>

    <record id="view_res_shift_form" model="ir.ui.view">
        <field name="name">res.shift.form</field>
        <field name="model">res.shift</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="shift_name"/>
                            <field name="day" invisible="1"/>
                        </group>
                        <group>
                            <field name="from_date"/>
                            <field name="to_date"/>
                        </group>
                    </group>
                </sheet>
                <!-- Attachment preview -->
                    <div class="o_attachment_preview" />
                    <!-- Chatter -->
                    <chatter reload_on_attachment="True"/>
            </form>
        </field>
    </record>
    <record id="action_res_shift" model="ir.actions.act_window">
        <field name="name">Shift</field>
        <field name="res_model">res.shift</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_res_shift"
              name="Shifts"
              parent="crm.crm_menu_config"
              action="action_res_shift"
              sequence="4"/>


</odoo>