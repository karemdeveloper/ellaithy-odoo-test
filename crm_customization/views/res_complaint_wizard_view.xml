<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_res_complaint_wizard_form" model="ir.ui.view">
        <field name="name">res.complaint.wizard.form</field>
        <field name="model">res.complaint.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Complaint">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="customer_id"/>
                            <field name="primary_phone" readonly="1"/>
                            <field name="salesperson_id" readonly="1"/>
                            <field name="complaint_reason_id"/>
                            <field name="complaint_type_id"/>
                        </group>
                        <group>
                            <field name="branch_id"/>
                            <field name="department"/>
                            <field name="assigned_to_ids" widget="many2many_tags"/>
                            <field name="escalation_line_id"/>
                            <field name="sla_duration" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_send_and_create" string="Send and Create" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_res_complaint_wizard" model="ir.actions.act_window">
        <field name="name">Create Complaint</field>
        <field name="res_model">res.complaint.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
