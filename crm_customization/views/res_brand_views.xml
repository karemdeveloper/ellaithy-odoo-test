<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =================== BRAND =================== -->
    <record id="view_res_brand_list" model="ir.ui.view">
        <field name="name">res.brand.list</field>
        <field name="model">res.brand</field>
        <field name="arch" type="xml">
            <list>
                <field name="brand_name"/>
            </list>
        </field>
    </record>

    <record id="view_res_brand_form" model="ir.ui.view">
        <field name="name">res.brand.form</field>
        <field name="model">res.brand</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="brand_name"/>
                    </group>
                </sheet>
                 <!-- Attachment preview -->
                    <div class="o_attachment_preview" />
                    <!-- Chatter -->
                    <chatter reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <record id="action_res_brand" model="ir.actions.act_window">
        <field name="name">Brand</field>
        <field name="res_model">res.brand</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_res_brand"
              name="Brand"
              parent="crm.crm_menu_config"
              action="action_res_brand"
              sequence="2"/>


</odoo>