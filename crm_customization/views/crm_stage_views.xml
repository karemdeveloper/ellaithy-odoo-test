<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit CRM Stage Form View -->
        <record id="view_crm_stage_form_inherit_is_lost" model="ir.ui.view">
            <field name="name">crm.stage.form.inherit.is.lost</field>
            <field name="model">crm.stage</field>
            <field name="inherit_id" ref="crm.crm_stage_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='is_won']" position="after">
                    <field name="is_lost"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
