<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =================== INACTIVE REQUEST =================== -->
    <record id="view_inactive_request_list" model="ir.ui.view">
        <field name="name">inactive.request.list</field>
        <field name="model">inactive.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="inactive_reason"/>
            </list>
        </field>
    </record>

    <record id="view_inactive_request_form" model="ir.ui.view">
        <field name="name">inactive.request.form</field>
        <field name="model">inactive.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            invisible="state!='to_approve'"
                            groups="crm_customization.group_confirmation_inactive_requests"
                            class="btn-primary"/>

                    <button name="action_refuse"
                            string="Refuse"
                            type="object"
                            invisible="state!='to_approve'"
                            groups="crm_customization.group_confirmation_inactive_requests"

                            class="btn-danger"/>
                    <field name="state" widget="statusbar" statusbar_visible="to_approve,approved,refused"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="date" readonly="state=='approved'"/>
                            <field name="inactive_reason" readonly="state=='approved'"/>
                        </group>
                        <group>

                            <field name="date_from" required="1" readonly="state=='approved'"/>
                            <field name="date_to" required="1" readonly="state=='approved'"/>
                            <field name="team_leader" invisible="1"/>

                        </group>
                    </group>
                </sheet>
                <!-- Attachment preview -->
                <div class="o_attachment_preview"/>
                <!-- Chatter -->
                <chatter reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <record id="action_inactive_request" model="ir.actions.act_window">
        <field name="name">Inactive Request</field>
        <field name="res_model">inactive.request</field>
        <field name="view_mode">list,form</field>

    </record>
    <menuitem id="menu_inactive_request"
              name="Inactive Request"
              parent="crm.crm_menu_root"
              action="action_inactive_request"
              sequence="26"/>


</odoo>