<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Opportunity Won Wizard Form -->
    <record id="view_opportunity_won_wizard_form" model="ir.ui.view">
        <field name="name">opportunity.won.wizard.form</field>
        <field name="model">opportunity.won.wizard</field>
        <field name="arch" type="xml">
            <form string="Mark as Won">
                <sheet>
                    <group>
                        <field name="lead_id" invisible="1"/>
                        <field name="chassis_number" string="Chassis/Serial Number"/>
                        <field name="sale_order_id"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Mark as Won" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
