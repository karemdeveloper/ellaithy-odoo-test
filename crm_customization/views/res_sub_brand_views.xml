<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =================== SUB BRAND =================== -->
    <record id="view_res_sub_brand_list" model="ir.ui.view">
        <field name="name">res.sub.brand.list</field>
        <field name="model">res.sub.brand</field>
        <field name="arch" type="xml">
            <list>
                <field name="brand"/>
                <field name="sub_brand_name"/>
            </list>
        </field>
    </record>

    <record id="view_res_sub_brand_form" model="ir.ui.view">
        <field name="name">res.sub.brand.form</field>
        <field name="model">res.sub.brand</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="brand"/>
                        <field name="sub_brand_name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_res_sub_brand" model="ir.actions.act_window">
        <field name="name"> Sub Brand</field>
        <field name="res_model">res.sub.brand</field>
        <field name="view_mode">list,form</field>
    </record>
     <menuitem id="menu_res_sub_brand"
              name="Sub Brand"
              parent="crm.crm_menu_config"
              action="action_res_sub_brand"
              sequence="2"/>

</odoo>