<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =================== CALL TYPE =================== -->
    <record id="view_call_type_list" model="ir.ui.view">
        <field name="name">call.type.list</field>
        <field name="model">call.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_call_type_form" model="ir.ui.view">
        <field name="name">call.type.form</field>
        <field name="model">call.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
                 <!-- Attachment preview -->
                    <div class="o_attachment_preview" />
                    <!-- Chatter -->
                    <chatter reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <record id="action_call_type" model="ir.actions.act_window">
        <field name="name">Call Type</field>
        <field name="res_model">call.type</field>
        <field name="view_mode">list,form</field>
    </record>
     <menuitem id="menu_call_type"
              name="Call Type"
              parent="crm.crm_menu_config"
              action="action_call_type"
              sequence="2"/>


</odoo>