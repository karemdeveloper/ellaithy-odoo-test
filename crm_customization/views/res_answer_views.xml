<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =================== ANSWERS =================== -->
    <record id="view_res_answer_list" model="ir.ui.view">
        <field name="name">res.answer.list</field>
        <field name="model">res.answer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_res_answer_form" model="ir.ui.view">
        <field name="name">res.answer.form</field>
        <field name="model">res.answer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
                 <!-- Attachment preview -->
                    <div class="o_attachment_preview" />
                    <!-- Chatter -->
                    <chatter reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <record id="action_res_answer" model="ir.actions.act_window">
        <field name="name">Answers</field>
        <field name="res_model">res.answer</field>
        <field name="view_mode">list,form</field>
    </record>
     <menuitem id="menu_res_answer"
              name="Answer"
              parent="crm.crm_menu_config"
              action="action_res_answer"
              sequence="2"/>


</odoo>