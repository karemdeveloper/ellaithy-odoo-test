<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =================== DAYS =================== -->
    <record id="view_res_day_list" model="ir.ui.view">
        <field name="name">res.day.list</field>
        <field name="model">res.day</field>
        <field name="arch" type="xml">
            <list>
                <field name="day"/>
            </list>
        </field>
    </record>

    <record id="view_res_day_form" model="ir.ui.view">
        <field name="name">res.day.form</field>
        <field name="model">res.day</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="day" required="1"/>
                    </group>
                </sheet>
                 <!-- Attachment preview -->
                    <div class="o_attachment_preview" />
                    <!-- Chatter -->
                    <chatter reload_on_attachment="True"/>
            </form>
        </field>
    </record>
    <record id="action_res_day" model="ir.actions.act_window">
        <field name="name">Day</field>
        <field name="res_model">res.day</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_res_day"
              name="Days"
              parent="crm.crm_menu_config"
              action="action_res_day"
              sequence="4"/>



</odoo>