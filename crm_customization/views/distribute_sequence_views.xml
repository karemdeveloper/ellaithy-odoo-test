<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =================== distribute sequence =================== -->
    <record id="view_distribute_sequence_list" model="ir.ui.view">
        <field name="name">distribute.sequence.list</field>
        <field name="model">distribute.sequence</field>
        <field name="arch" type="xml">
            <list string="Distribution Sequence" default_order="sequence asc">
                <field name="sequence" widget="handle" />
                <field name="sales_person" />
                <field name="branch" />
                <field name="shift" />
                <field name="from_date" widget="float_time" />
                <field name="to_date" widget="float_time" />
                <field name="state" />
            </list>

        </field>
    </record>

    <record id="view_distribute_sequence_form" model="ir.ui.view">
        <field name="name">distribute.sequence.form</field>
        <field name="model">distribute.sequence</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="sales_person" />
                            <field name="branch" />
                            <field name="shift" />
                        </group>
                        <group>
                            <field name="from_date" widget="float_time" />
                            <field name="to_date" widget="float_time" />
                            <field name="state" />

                        </group>
                    </group>
                </sheet>
                <!-- Attachment preview -->
                <div class="o_attachment_preview" />
                <!-- Chatter -->
                <chatter reload_on_attachment="True" />
            </form>
        </field>
    </record>

    <record id="view_distribute_sequence_search" model="ir.ui.view">
        <field name="name">distribute.sequence.search</field>
        <field name="model">distribute.sequence</field>
        <field name="arch" type="xml">
            <search string="Distribution Sequence">
                <field name="sales_person" string="Salesperson" />
                <field name="branch" />
                <field name="shift" />
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]" />
                <group expand="0" string="Group By">
                    <filter name="group_by_sales_person" string="Salesperson"
                        context="{'group_by': 'sales_person'}" />
                    <filter name="group_by_branch" string="Branch" context="{'group_by': 'branch'}" />
                    <filter name="group_by_shift" string="Shift" context="{'group_by': 'shift'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_distribute_sequence" model="ir.actions.act_window">
        <field name="name">Distribution Sequence</field>
        <field name="res_model">distribute.sequence</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_distribute_sequence"
        name="Distribution Sequence"
        parent="crm.crm_menu_config"
        action="action_distribute_sequence"
        sequence="2" />


</odoo>