<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit CRM Opportunity Form -->
    <record id="view_crm_lead_form_inherit_branch_brand" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.branch.brand</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_set_won_rainbowman']" position="attributes">
                <attribute name="groups">crm_customization.group_crm_opportunity_stage</attribute>
            </xpath>
            <xpath expr="//button[@name='%(crm.crm_lead_lost_action)d']" position="attributes">
                <attribute name="groups">crm_customization.group_crm_opportunity_stage</attribute>
            </xpath>
            <xpath expr="//form[1]/header[1]/button[@name='iap_enrich'][2]" position="attributes">
                <attribute name="groups">crm_customization.group_crm_opportunity_stage</attribute>
            </xpath>
            <xpath expr="//button[@name='action_sale_quotations_new']" position="attributes">
                <attribute name="groups">crm_customization.group_crm_opportunity_stage</attribute>
            </xpath>
            <xpath expr="//div[@class='col-auto pb-2 pb-md-0 w-100 w-sm-auto']" position="replace"/>
            <xpath expr="//form[1]/sheet[1]/group[1]/group[not(@name)][1]/div[1]/field[@name='priority']"
                   position="replace"/>
            <xpath expr="//field[@name='date_deadline']" position="replace"/>
            <xpath expr="//form[1]/sheet[1]/group[1]/group[not(@name)][1]/label[1]" position="replace"/>
            <!-- <xpath expr="//field[@name='probability']" position="replace"/> -->
            <xpath expr="//form[1]/sheet[1]/div[not(@name)][1]/h2[1]/div[1]/label[1]" position="replace"/>

            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="opportunity_type_display"/>
                <field name="area_name"/>
                <field name="branch_name"/>
                <field name="opportunity_type" invisible="1"/>
                <field name="service_id" invisible="opportunity_type != 'service'"/>
                <field name="brand_name2" widget="many2many_tags"/>
                <field name="sub_brand_name2" widget="many2many_tags" domain="[('brand', 'in', brand_name2)]"/>
                <field name="brand_used_id" widget="many2many_tags" invisible="opportunity_type=='new'"/>
                <field name="sub_brand_used_id" widget="many2many_tags" invisible="opportunity_type=='new'" domain="[('brand', 'in', brand_used_id)]"/>
                <field name="source_name"/>
                <field name="model" invisible="opportunity_type=='new'"/>
                <field name="kilometers" invisible="opportunity_type=='new'"/>
                <field name="sales_team" invisible="1"/>
                <field name="sla_duration"/>
                <field name="late_days"/>
                <field name="marketing_offer"/>
                <field name="call_type"/>
                <field name="has_feedback" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='lead']" position="after">
                <page name="feedback_tab" string="Feedback">
                    <field name="feedback_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="date"/>
                            <field name="salesperson_id"/>
                            <!--                            <field name="feedback"/>-->
                            <field name="feedback2"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <xpath expr="//field[@name='sales_team']" position="after">
                <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='lead']/group[1]/group[@name='Misc']/field[@name='team_id']"
                       position="move"/>
            </xpath>
            <xpath expr="//page[@name='lead']" position="replace"/>


        </field>
    </record>
    <record id="view_crm_lead_kanban_inherit" model="ir.ui.view">
        <field name="name">crm.lead.kanban.inherit.branch.brand</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="phone" display="full" options="{}" widget="phone"/>
                <field name="opportunity_type" invisible="1"/>
                <field name="opportunity_type_display" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='activity_ids']" position="replace"/>
            
            <!-- Remove priority stars -->
            <xpath expr="//field[@name='priority']" position="replace"/>
            
            <!-- Remove partner name (client name) from kanban card -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <!-- Add opportunity type badge in kanban card -->
            <xpath expr="//kanban[1]/templates[1]/t[@t-name='card']/footer[1]" position="before">
                <span t-if="record.opportunity_type_display.raw_value" 
                      class="badge rounded-pill text-bg-info me-1"
                      t-att-title="record.opportunity_type.value">
                    <t t-esc="record.opportunity_type_display.value"/>
                </span>
            </xpath>

            <xpath expr="//kanban[1]/templates[1]/t[@t-name='card']/footer[1]" position="after">
                <a type="object"
                   name="action_open_feedback_wizard"
                   class="btn btn-primary btn-sm mt-1"
                   t-att-title="'Add Feedback'">
                    <i class="fa fa-comment"></i>
                    Add Feedback
                </a>
                <a type="object"
                   name="action_open_won_wizard"
                   class="btn btn-success btn-sm mt-1"
                   t-att-title="'Mark as Won'">
                    <i class="fa fa-check"></i>
                    Won
                </a>
                <a type="action"
                   name="%(crm.crm_lead_lost_action)d"
                   class="btn btn-danger btn-sm mt-1"
                   t-att-title="'Mark as Lost'">
                    <i class="fa fa-times"></i>
                    Lost
                </a>
            </xpath>

        </field>
    </record>
    <record id="view_crm_lead_list_inherit" model="ir.ui.view">
        <field name="name">crm.lead.list.inherit.branch.brand</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_reschedule_meeting']" position="after">
                <button name="action_open_feedback_wizard"
                        string="Add Feedback"
                        type="object"
                        class="btn-primary"
                />
            </xpath>
            <xpath expr="//button[@name='%(crm.action_lead_mail_compose)d']" position="replace"/>
            <xpath expr="//button[@name='%(crm_sms.crm_lead_act_window_sms_composer_multi)d']" position="replace"/>

            <xpath expr="//field[@name='contact_name']" position="after">
                <field name="branch_name" optional="show"/>
                <field name="area_name" optional="show"/>
                <field name="brand_name2" optional="show" widget="many2many_tags"/>
                <field name="sub_brand_name2" optional="show" widget="many2many_tags"/>
                <field name="brand_used_id" optional="show" widget="many2many_tags"/>
                <field name="sub_brand_used_id" optional="show" widget="many2many_tags"/>
                <field name="source_name" optional="show"/>
                <field name="sales_team" column_invisible="1"/>
                <field name="call_type" optional="show"/>
                <field name="sla_duration" optional="show"/>
                <field name="phone" optional="show" widget="phone"/>
            </xpath>
        </field>
    </record>
    <record id="view_crm_lead_filter_inherit_has_feedback" model="ir.ui.view">
        <field name="name">crm.lead.search.inherit.has.feedback</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">

            <xpath expr="//filter[@name='saleschannel']" position="after">
                <filter name="studio_group_by_9ag_1j9595aef" string="Feedback"
                        context="{'group_by': 'has_feedback'}"/>
            </xpath>

        </field>
    </record>

    <record id="crm.res_partner_menu_customer" model="ir.ui.menu">
        <field name="sequence">0</field>
    </record>
    <record id="crm.menu_crm_opportunities" model="ir.ui.menu">
        <field name="name">My Opportunities</field>
    </record>
    <record id="crm.crm_lead_action_pipeline" model="ir.actions.act_window">
        <field name="name">Opportunity</field>
    </record>


</odoo>
