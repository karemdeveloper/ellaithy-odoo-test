<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit CRM Opportunity Form -->
    <record id="view_crm_lead_form_inherit_branch_brand" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.branch.brand</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!-- Salesperson: readonly for regular users, editable for Sales All Documents -->
            <xpath expr="//field[@name='user_id']" position="replace">
                <field name="user_id" required="1" readonly="1"
                       groups="sales_team.group_sale_salesman"/>
                <field name="user_id" required="1"
                       groups="sales_team.group_sale_manager,sales_team.group_sale_salesman_all_leads"/>
                <field name="not_lead_access"/>
            </xpath>
            <xpath expr="//group[@name='opportunity_partner']//field[@name='partner_id']" position="attributes">
                <attribute name="readonly">not_lead_access</attribute>
            </xpath>
            <xpath expr="//field[@name='email_from']" position="attributes">
                <attribute name="readonly">not_lead_access</attribute>
            </xpath>
            <xpath expr="//field[@name='phone']" position="attributes">
                <attribute name="readonly">not_lead_access</attribute>
            </xpath>
            <!--            <xpath expr="//field[@name='user_id']" position="attributes">-->
            <!--                <attribute name="readonly">not_lead_access</attribute>-->
            <!--            </xpath>-->
            <xpath expr="//field[@name='tag_ids']" position="attributes">
                <attribute name="readonly">not_lead_access</attribute>
            </xpath>


            <!-- Add ibs_closed_at field -->
            <xpath expr="//sheet/field[@name='active']" position="after">
                <field name="ibs_closed_at" invisible="1"/>
            </xpath>

            <!-- Add Lost ribbon inside sheet -->
            <xpath expr="//sheet/div[@name='button_box']" position="after">
                <widget name="web_ribbon" title="Lost" bg_color="text-bg-danger" invisible="not ibs_closed_at"/>
            </xpath>

            <xpath expr="//button[@name='action_set_won_rainbowman']" position="attributes">
                <attribute name="groups">crm_customization.group_crm_opportunity_stage</attribute>
            </xpath>
            <xpath expr="//button[@name='%(crm.crm_lead_lost_action)d']" position="attributes">
                <attribute name="groups">crm_customization.group_crm_opportunity_stage</attribute>
            </xpath>
            <xpath expr="//form[1]/header[1]/button[@name='iap_enrich'][2]" position="attributes">
                <attribute name="groups">crm_customization.group_crm_opportunity_stage</attribute>
            </xpath>
            <xpath expr="//button[@name='action_sale_quotations_new']" position="attributes">
                <attribute name="groups">crm_customization.group_crm_opportunity_stage</attribute>
            </xpath>
            <xpath expr="//div[@class='col-auto pb-2 pb-md-0 w-100 w-sm-auto']" position="replace"/>
            <xpath expr="//form[1]/sheet[1]/group[1]/group[not(@name)][1]/div[1]/field[@name='priority']"
                   position="replace"/>
            <xpath expr="//field[@name='date_deadline']" position="replace"/>
            <xpath expr="//form[1]/sheet[1]/group[1]/group[not(@name)][1]/label[1]" position="replace"/>
            <!-- <xpath expr="//field[@name='probability']" position="replace"/> -->
            <xpath expr="//form[1]/sheet[1]/div[not(@name)][1]/h2[1]/div[1]/label[1]" position="replace"/>

            <!-- Make phone field required -->
            <xpath expr="//field[@name='phone']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>

            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="opportunity_type_display"/>
                <field name="area_name" options="{'no_create': True, 'no_edit': True}" readonly="not_lead_access"/>
                <field name="branch_name" options="{'no_create': True, 'no_edit': True}" required="1"
                       groups="sales_team.group_sale_manager"/>
                <field name="branch_name" options="{'no_create': True, 'no_edit': True}" required="1" readonly="1"
                       groups="!sales_team.group_sale_manager"/>
                <field name="opportunity_type" invisible="1"/>
                <field name="service_id" invisible="opportunity_type != 'service'"
                       options="{'no_create': True, 'no_edit': True}"/>
                <field name="brand_name2" widget="many2many_tags" options="{'no_create': True, 'no_edit': True}"
                       required="1" readonly="not_lead_access"/>
                <field name="sub_brand_name2" widget="many2many_tags" domain="[('brand', 'in', brand_name2)]"
                       options="{'no_create': True, 'no_edit': True}" required="1" readonly="not_lead_access"/>
                <field name="brand_used_id" widget="many2many_tags" invisible="opportunity_type=='new'"
                       options="{'no_create': True, 'no_edit': True}" readonly="not_lead_access"/>
                <field name="sub_brand_used_id" widget="many2many_tags" invisible="opportunity_type=='new'"
                       domain="[('brand', 'in', brand_used_id)]" options="{'no_create': True, 'no_edit': True}"
                       readonly="not_lead_access"/>
                <field name="source_name" options="{'no_create': True, 'no_edit': True}" required="1"
                       readonly="not_lead_access"/>
                <field name="model" invisible="opportunity_type=='new'" readonly="not_lead_access"/>
                <field name="kilometers" invisible="opportunity_type=='new'" readonly="not_lead_access"/>
                <field name="sales_team" invisible="1"/>
                <field name="sla_duration"/>
                <field name="late_days"/>
                <field name="marketing_offer" options="{'no_create': True, 'no_edit': True}"
                       readonly="not_lead_access"/>
                <field name="call_type" options="{'no_create': True, 'no_edit': True}" required="1"
                       readonly="not_lead_access"/>
                <field name="has_feedback" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='lead']" position="after">
                <page name="feedback_tab" string="Feedback">
                    <field name="feedback_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="date"/>
                            <field name="salesperson_id" options="{'no_create': True, 'no_edit': True}"/>
                            <!--                            <field name="feedback"/>-->
                            <field name="feedback2"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <xpath expr="//field[@name='sales_team']" position="after">
                <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='lead']/group[1]/group[@name='Misc']/field[@name='team_id']"
                       position="move"/>
            </xpath>
            <xpath expr="//field[@name='team_id']" position="replace">
                <field name="team_id"
                       options="{'no_create': True, 'no_edit': True}"
                       groups="sales_team.group_sale_manager"/>

                <field name="team_id"
                       options="{'no_create': True, 'no_edit': True}"
                       readonly="1"
                       groups="!sales_team.group_sale_manager"/>
            </xpath>
            <xpath expr="//page[@name='lead']" position="replace"/>

            <xpath expr="//button[@name='action_set_won_rainbowman']" position="attributes">
                <attribute name="name">action_open_won_wizard</attribute>
            </xpath>

        </field>
    </record>
    <record id="view_crm_lead_kanban_inherit" model="ir.ui.view">
        <field name="name">crm.lead.kanban.inherit.branch.brand</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <!-- Add lost ribbon at the very beginning of card template -->
            <xpath expr="//kanban[1]/templates[1]/t[@t-name='card']/field[@name='name']" position="before">
                <t t-set="lost_ribbon" t-value="record.ibs_closed_at.raw_value"/>
                <widget name="web_ribbon" title="Lost" bg_color="text-bg-danger" invisible="not ibs_closed_at"/>
            </xpath>

            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="phone" display="full" options="{}" widget="phone"/>
                <field name="opportunity_type" invisible="1"/>
                <field name="opportunity_type_display" invisible="1"/>
                <field name="ibs_closed_at" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='activity_ids']" position="replace"/>

            <!-- Remove priority stars -->
            <xpath expr="//field[@name='priority']" position="replace"/>

            <!-- Remove partner name (client name) from kanban card -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Add opportunity type badge in kanban card -->
            <xpath expr="//kanban[1]/templates[1]/t[@t-name='card']/footer[1]" position="before">
                <div class="d-flex gap-1 mb-1">
                    <span t-if="record.opportunity_type_display.raw_value" class="badge rounded-pill text-bg-info"
                          t-att-title="record.opportunity_type.value">
                        <t t-esc="record.opportunity_type_display.value"/>
                    </span>
                </div>
                <!-- Display Source, Brand, and Sub Brand in kanban card -->
                <div class="mt-2">
                    <div t-if="record.partner_id">
                        <strong>Customer:</strong>
                        <field name="partner_id"/>
                    </div>
                    <div t-if="record.source_name">
                        <strong>Source:</strong>
                        <field name="source_name"/>
                    </div>
                    <div t-if="record.brand_name2">
                        <strong>Brand:</strong>
                        <field name="brand_name2"/>
                    </div>
                    <div t-if="record.sub_brand_name2">
                        <strong>Sub Brand:</strong>
                        <field name="sub_brand_name2"/>
                    </div>
                    <div t-if="record.create_date">
                        <strong>Created On:</strong>
                        <field name="create_date"/>
                    </div>
                </div>
            </xpath>

            <xpath expr="//kanban[1]/templates[1]/t[@t-name='card']/footer[1]" position="after">
                <a type="object" name="action_open_feedback_wizard" class="btn btn-primary btn-sm mt-1"
                   t-att-title="'Add Feedback'">
                    <i class="fa fa-comment"></i>
                    Add Feedback
                </a>
                <a type="object" name="action_open_won_wizard" class="btn btn-success btn-sm mt-1"
                   t-att-title="'Mark as Won'">
                    <i class="fa fa-check"></i>
                    Won
                </a>
                <a type="action" name="%(crm.crm_lead_lost_action)d" class="btn btn-danger btn-sm mt-1"
                   t-att-title="'Mark as Lost'">
                    <i class="fa fa-times"></i>
                    Lost
                </a>
            </xpath>

        </field>
    </record>

    <!-- Inherit Quick Create Form for Kanban -->
    <record id="view_crm_lead_kanban_quick_create_inherit" model="ir.ui.view">
        <field name="name">crm.lead.kanban.quick.create.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.quick_create_opportunity_form"/>
        <field name="arch" type="xml">
            <!-- Add Source, Brand, and Sub Brand fields to quick create -->
            <xpath expr="//group/field[@name='phone']" position="after">
                <field name="source_name" string="Source" placeholder="Source"
                       options="{'no_create': True, 'no_edit': True}" required="1"/>
                <field name="branch_name" string="Branch" placeholder="Branch"
                       options="{'no_create': True, 'no_edit': True}" required="1"/>
                <field name="brand_name2" string="Brand" placeholder="Brand" widget="many2many_tags"
                       options="{'no_create': True, 'no_edit': True}" required="1"/>
                <field name="sub_brand_name2" string="Sub Brand" placeholder="Sub Brand" widget="many2many_tags"
                       domain="[('brand', 'in', brand_name2)]" options="{'no_create': True, 'no_edit': True}"
                       required="1"/>
                <field name="call_type" string="Call Type" placeholder="Call Type"
                       options="{'no_create': True, 'no_edit': True}" required="1"/>
            </xpath>
        </field>
    </record>
    <record id="view_crm_lead_list_inherit" model="ir.ui.view">
        <field name="name">crm.lead.list.inherit.branch.brand</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_reschedule_meeting']" position="after">
                <button name="action_open_feedback_wizard" string="Add Feedback" type="object" class="btn-primary"/>
            </xpath>
            <xpath expr="//button[@name='%(crm.action_lead_mail_compose)d']" position="replace"/>
            <xpath expr="//button[@name='%(crm_sms.crm_lead_act_window_sms_composer_multi)d']" position="replace"/>

            <xpath expr="//field[@name='contact_name']" position="after">
                <field name="branch_name" optional="show" options="{'no_create': True, 'no_edit': True}"/>
                <field name="area_name" optional="show" options="{'no_create': True, 'no_edit': True}"/>
                <field name="brand_name2" optional="show" widget="many2many_tags"
                       options="{'no_create': True, 'no_edit': True}"/>
                <field name="sub_brand_name2" optional="show" widget="many2many_tags"
                       options="{'no_create': True, 'no_edit': True}"/>
                <field name="brand_used_id" optional="show" widget="many2many_tags"
                       options="{'no_create': True, 'no_edit': True}"/>
                <field name="sub_brand_used_id" optional="show" widget="many2many_tags"
                       options="{'no_create': True, 'no_edit': True}"/>
                <field name="source_name" optional="show" options="{'no_create': True, 'no_edit': True}"/>
                <field name="sales_team" column_invisible="1"/>
                <field name="call_type" optional="show" options="{'no_create': True, 'no_edit': True}"/>
                <field name="sla_duration" optional="show"/>
                <field name="phone" optional="show" widget="phone"/>
            </xpath>
        </field>
    </record>
    <record id="view_crm_lead_filter_inherit_has_feedback" model="ir.ui.view">
        <field name="name">crm.lead.search.inherit.has.feedback</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">

            <!-- Add filter for opportunities created within 2 hours in new stage -->
            <xpath expr="//search//filter[1]" position="before">
                <filter name="new_within_2hrs" string="New (Within 2 Hours)"
                        domain="[('is_new_within_2hrs', '=', True)]"
                        help="Opportunities created within last 2 hours and still in new stage"/>
                <filter name="new_2hrs_no_action" string="Within 2 Hours - No Action"
                        domain="[('is_new_within_2hrs', '=', True), ('has_feedback', '=', False)]"
                        help="Opportunities created within last 2 hours with no feedback/action taken"/>
                <filter name="new_more_than_2hrs" string="New - More Than 2 Hours"
                        domain="[('is_new_more_than_2hrs', '=', True)]"
                        help="Opportunities created more than 2 hours ago and still in new stage"/>
                <filter name="new_more_than_2hrs_no_action" string="More Than 2 Hours - No Action"
                        domain="[('is_new_more_than_2hrs', '=', True), ('has_feedback', '=', False)]"
                        help="Opportunities in new stage for more than 2 hours with no feedback/action taken"/>
                <separator/>
            </xpath>

            <xpath expr="//filter[@name='saleschannel']" position="after">
                <filter name="studio_group_by_9ag_1j9595aef" string="Feedback" context="{'group_by': 'has_feedback'}"/>
            </xpath>

        </field>
    </record>

    <record id="crm.res_partner_menu_customer" model="ir.ui.menu">
        <field name="sequence">0</field>
    </record>
    <record id="crm.menu_crm_opportunities" model="ir.ui.menu">
        <field name="name">My Opportunities</field>
    </record>
    <record id="crm.crm_lead_action_pipeline" model="ir.actions.act_window">
        <field name="name">Opportunity</field>
    </record>


</odoo>