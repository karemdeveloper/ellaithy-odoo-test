<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =================== SOURCE =================== -->
    <record id="view_res_source_list" model="ir.ui.view">
        <field name="name">res.source.list</field>
        <field name="model">res.source</field>
        <field name="arch" type="xml">
            <list>
                <field name="source_name"/>
            </list>
        </field>
    </record>

    <record id="view_res_source_form" model="ir.ui.view">
        <field name="name">res.source.form</field>
        <field name="model">res.source</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="source_name"/>
                    </group>
                </sheet>
                 <!-- Attachment preview -->
                    <div class="o_attachment_preview" />
                    <!-- Chatter -->
                    <chatter reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <record id="action_res_source" model="ir.actions.act_window">
        <field name="name">source</field>
        <field name="res_model">res.source</field>
        <field name="view_mode">list,form</field>
    </record>
     <menuitem id="menu_res_source"
              name="sources"
              parent="crm.crm_menu_config"
              action="action_res_source"
              sequence="2"/>

</odoo>