<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =================== SURVEY =================== -->
    <record id="view_res_survey_list" model="ir.ui.view">
        <field name="name">res.survey.list</field>
        <field name="model">res.survey</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
            </list>
        </field>
    </record>

    <record id="view_res_survey_form" model="ir.ui.view">
        <field name="name">res.survey.form</field>
        <field name="model">res.survey</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="q1_sales_person" widget="radio"/>
                            <field name="q2_paper_speed" widget="radio"/>
                            <field name="q3_insurance" widget="radio"/>


                        </group>
                        <group>
                            <field name="q4_used_car" widget="radio"/>
                            <field name="q5_offer_shown" widget="radio"/>
                            <field name="q6_tip_request" widget="radio"/>
                            <field name="comment"/>
                        </group>
                    </group>
                </sheet>
                <!-- Attachment preview -->
                <div class="o_attachment_preview"/>
                <!-- Chatter -->
                <chatter reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <record id="action_res_survey" model="ir.actions.act_window">
        <field name="name">Survey</field>
        <field name="res_model">res.survey</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_res_survey"
              name="Survey"
              parent="crm.crm_menu_config"
              action="action_res_survey"
              sequence="2"/>


</odoo>