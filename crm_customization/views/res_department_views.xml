<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =================== DEPARTMENTS =================== -->
    <record id="view_res_department_list" model="ir.ui.view">
        <field name="name">res.department.list</field>
        <field name="model">res.department</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="alias_email"/>
            </list>
        </field>
    </record>

    <record id="view_res_department_form" model="ir.ui.view">
        <field name="name">res.department.form</field>
        <field name="model">res.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="alias_email" placeholder="department@example.com"/>
                        <field name="department_user" widget="many2many_tags"/>
                    </group>
                </sheet>
                 <!-- Attachment preview -->
                    <div class="o_attachment_preview" />
                    <!-- Chatter -->
                    <chatter reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <record id="action_res_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">res.department</field>
        <field name="view_mode">list,form</field>
    </record>
     <menuitem id="menu_res_department"
              name="Department"
              parent="crm.crm_menu_config"
              action="action_res_department"
              sequence="2"/>


</odoo>