<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <!--
        Disable standard Odoo CRM rules that show ALL leads/contacts without branch restrictions.
        These rules are replaced by our custom branch-aware rules in groups.xml
    -->

    <!-- Deactivate standard "All Documents" rule for leads (from crm module) -->
    <record id="crm.crm_lead_rule_all" model="ir.rule">
        <field name="active" eval="False"/>
    </record>

    <!-- Deactivate standard partner rule for "See all leads" group (from base module) -->
    <record id="base.res_partner_rule_private_group" model="ir.rule">
        <field name="active" eval="False"/>
    </record>

</odoo>
