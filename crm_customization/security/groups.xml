<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- CRM Customer Group -->
    <record id="group_crm_customer" model="res.groups">
        <field name="name">CRM Customer</field>
    </record>

    <!-- Sales Customer Group -->
    <record id="group_sales_customer" model="res.groups">
        <field name="name">Sales Customer</field>
    </record>
    <record id="group_crm_opportunity_stage" model="res.groups">
        <field name="name">CRM Opportunity Stage</field>
    </record>

    <record id="group_confirmation_inactive_requests" model="res.groups">
        <field name="name">Confirmation In Active Requests</field>
    </record>
    <record id="group_view_inactive_requests" model="res.groups">
        <field name="name">View InActive Requests</field>
    </record>
    <record id="inactive_request_rule_user_own" model="ir.rule">
        <field name="name">Inactive Request - User Own Records</field>
        <field name="model_id" ref="model_inactive_request"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="inactive_request_rule_view_all" model="ir.rule">
        <field name="name">Inactive Request - View All</field>
        <field name="model_id" ref="model_inactive_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('crm_customization.group_view_inactive_requests'))]"/>
    </record>
    <record id="inactive_request_rule_team_leader" model="ir.rule">
        <field name="name">Inactive Request - Team Leader Records</field>
        <field name="model_id" ref="model_inactive_request"/>
        <field name="domain_force">[('team_leader', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>


    <!-- Team Leader Group -->
    <record id="group_sale_team_leader" model="res.groups">
        <field name="name">User: Team Leader</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <!-- يرث من salesman الأصلي -->
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">
            The user can access all records related to their own sales team (team leader access).
        </field>
    </record>

    <!-- تحديث الجروب الأصلي "All Documents" ليورّث من Team Leader -->
    <record id="sales_team.group_sale_salesman_all_leads" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('crm_customization.group_sale_team_leader'))]"/>
    </record>


    <record id="crm_lead_team_leader_rule" model="ir.rule">
        <field name="name">Leads: Only show my team's leads</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="groups" eval="[(4, ref('group_sale_team_leader'))]"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('team_id.user_id', '=', user.id)]</field>
    </record>

    <!-- Partner/Contact Rule for Team Leader -->
    <record id="partner_team_leader_rule" model="ir.rule">
        <field name="name">Partner: Only show my team's contacts</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(4, ref('group_sale_team_leader'))]"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('team_id.user_id', '=', user.id)]</field>
    </record>

    <!-- Complaint Groups -->
    <record id="group_complaint_branch_manager" model="res.groups">
        <field name="name">Complaint Branch Manager</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="comment">Can see all complaints in their branch</field>
    </record>

    <record id="group_complaint_customer_care_manager" model="res.groups">
        <field name="name">Complaint Customer Care Manager</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="comment">Can see all complaints</field>
    </record>

    <!-- Complaint Record Rules -->
    <!-- Rule 1: Own Complaints -->
    <record id="complaint_rule_own" model="ir.rule">
        <field name="name">Complaint: Own Complaints</field>
        <field name="model_id" ref="model_res_complaint"/>
        <field name="domain_force">[('assigned_to_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Rule 2: Branch Manager sees branch complaints -->
    <record id="complaint_rule_branch_manager" model="ir.rule">
        <field name="name">Complaint: Branch Manager Complaints</field>
        <field name="model_id" ref="model_res_complaint"/>
        <field name="domain_force">[('branch_id', '=', user.branch_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_complaint_branch_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Rule 3: Customer Care Manager sees all complaints -->
    <record id="complaint_rule_customer_care_manager" model="ir.rule">
        <field name="name">Complaint: Customer Care Manager - All Complaints</field>
        <field name="model_id" ref="model_res_complaint"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_complaint_customer_care_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>


</odoo>
