<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Incorrect Information Complaint Email Template (Arabic) -->
    <record id="email_template_complaint_incorrect_info"
            model="mail.template">
        <field name="name">Complaint: Incorrect Information (Arabic)</field>
        <field name="model_id"
               ref="model_res_complaint"/>
        <field name="subject">شكوي بسبب معلومة خاطئة – فرع {{object.branch_id.branch_name or 'غير محدد'}}</field>
        <field name="email_from">{{(object.create_uid.email_formatted or user.email_formatted) or ''}}</field>
        <field name="body_html"
               type="html">
            <div style="margin: 0px; padding: 0px; direction: rtl; text-align: right; font-family: Arial, sans-serif;">
                <t t-if="object.complaint_state == 'solved'">
                    <p style="color: green; font-weight: bold;">
                        ✅ تم حل الشكوى
                    </p>
                </t>
                <p style="font-size: 14px; margin-bottom: 10px;">
                    <strong>رقم الشكوى:</strong>
                    <t t-esc="object.name"/>
                </p>
                <p style="font-size: 14px; margin-bottom: 15px;">
                    استاذ /
                    <t t-esc="object.branch_id.branch_manager.partner_id.name or 'مدير الفرع'"/>
                    <br/>
                    <br/>
                    تحية طيبة وبعد ,,,
                </p>

                <p style="margin: 10px 0px; padding: 0px; font-size: 14px; line-height: 1.8;">
                    وردنا اتصال من العميل لاحق الذكر يشكو من مسئول المبيعات استاذ
                    <strong>
                        <t t-esc="object.salesperson_id.name  or  'غير محدد'"/>

                    </strong>
                    حيث انه قام بتوضيح معلومة خاطئة الي العميل
                    <br/>
                    <br/>
                    فبرجاء مراجعة الامر والتواصل مع العميل لتوضيح المعلومة الصحيحه و حل سوء الفهم وافادتنا باخر
                    المستجدات.
                </p>

                <div style="background-color: #fff8e1; padding: 12px; border-right: 3px solid #ffc107; margin: 15px 0; border-radius: 4px;">
                    <p style="margin: 0; font-size: 13px; color: #f57c00;">
                        <strong>📋 ملاحظة:</strong>
                        يرجى توثيق المعلومة الخاطئة والمعلومة الصحيحة في سجل الشكوى
                    </p>
                </div>

                <p style="margin: 20px 0px 10px 0px; padding: 0px; font-size: 14px; font-weight: bold; color: #1976d2;">
                    ℹ️ يرجى التواصل مع العميل وتوضيح المعلومة الصحيحة في أقرب وقت
                </p>

                <div style="margin: 20px 0px; text-align: center;">
                    <a href="/web#id={{object.id}}&amp;model=res.complaint&amp;view_type=form"
                       style="padding: 10px 20px; font-size: 14px; color: #FFFFFF; background-color: #2196f3; border: none; border-radius: 4px; text-decoration: none; display: inline-block; font-weight: bold;">
                        عرض تفاصيل الشكوى
                    </a>
                </div>

                <p style="margin: 20px 0px 0px 0px; padding: 0px; font-size: 13px; color: #666;">
                    مع خالص التحية والتقدير،
                    <br/>
                    <t t-esc="object.create_uid.name or 'نظام إدارة الشكاوى'"/>
                </p>

                <hr style="border: none; border-top: 1px solid #e0e0e0; margin: 20px 0;"/>

                <p style="margin: 0px; padding: 0px; font-size: 11px; color: #999; text-align: center;">
                    هذه رسالة تلقائية من نظام إدارة الشكاوى - يرجى عدم الرد على هذا البريد مباشرة
                </p>
            </div>
        </field>
        <field name="auto_delete"
               eval="False"/>
    </record>
</odoo>
