<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Delay in Document Request Complaint Email Template (Arabic) -->
    <record id="email_template_complaint_doc_request_delay"
        model="mail.template">
        <field name="name">Complaint: Delay in Document Request (Arabic)</field>
        <field name="model_id"
            ref="model_res_complaint" />
        <field name="subject">شكوي بسبب تاخير طلب اوراق</field>
        <field name="email_from">{{(object.create_uid.email_formatted or user.email_formatted) or ''}}</field>
        <field name="body_html"
            type="html">
            <div style="margin: 0px; padding: 0px; direction: rtl; text-align: right; font-family: Arial, sans-serif;">
                <p style="font-size: 14px; margin-bottom: 15px;">
                    استاذ /
                    <t t-esc="object.branch_id.branch_manager.partner_id.name or 'مدير الفرع'" />
                    <br />
السادة ادارة الموارد البشرية                    <br />
                    تحية طيبة وبعد ,,,
                </p>

                <p style="margin: 10px 0px; padding: 0px; font-size: 14px; line-height: 1.8;">
                    وردنا شكوي من العميل لاحق الذكر بسبب عدم جاهزية الاوراق حتي الان وبعد المراجعة وجد ان مسئول المبيعات
                    استاذ                    <t t-esc="object.salesperson_id.name  or  'مسئول مبيعات'" />
قام بتأخير طلب الاوراق مما
                    ادي الي تاخير جاهزية الاوراق

                    <br />
                    <br />
                    <strong style="color: #c62828;">فبرجاء المراجعة واتخاذ اللازم</strong>
                    <hr style="border: none; border-top: 2px solid #ff9800; margin: 20px 0;" />
                    <p style="margin: 10px 0px; padding: 0px; font-size: 14px; font-weight: bold;">السادة ادارة الاوراق
                        <br />
                        <br />
تحية طيبة وبعد ,,,
                        <br />
                        <br />
                    </p>
                    <p style="margin: 10px 0px; padding: 0px; font-size: 14px; line-height: 1.8;">
                        <strong style="color: #1976d2;">برجاء الافادة في امكانيه استعجال الاوراق للعميل لاحق الذكر.
                        </strong>
                    </p>
                </p>

                <div style="background-color: #ffebee; padding: 15px; border-right: 3px solid #f44336; margin: 15px 0; border-radius: 4px;">
                    <p style="margin: 0 0 10px 0; font-size: 14px; color: #c62828; font-weight: bold;">
                        🚨 المشكلة:
                    </p>
                    <p style="margin: 5px 0; padding-right: 10px; font-size: 13px; color: #d32f2f;">
                        تأخر مسؤول المبيعات في طلب الأوراق بعد تسليم السيارة مما أدى إلى تأخير جاهزية الأوراق للعميل
                    </p>
                </div>

                <div style="background-color: #fff8e1; padding: 15px; border-right: 3px solid #ff9800; margin: 15px 0; border-radius: 4px;">
                    <p style="margin: 0 0 10px 0; font-size: 14px; color: #e65100; font-weight: bold;">
                        📋 الإجراءات المطلوبة من HR:
                    </p>
                    <ul style="margin: 5px 0; padding-right: 20px; font-size: 13px; color: #d84315;">
                        <li style="margin: 5px 0;">مراجعة الواقعة مع مسؤول المبيعات</li>
                        <li style="margin: 5px 0;">اتخاذ الإجراءات التصحيحية المناسبة</li>
                        <li style="margin: 5px 0;">التأكيد على أهمية طلب الأوراق فور التسليم</li>
                    </ul>
                </div>

                <div style="background-color: #e3f2fd; padding: 15px; border-right: 3px solid #2196f3; margin: 15px 0; border-radius: 4px;">
                    <p style="margin: 0 0 10px 0; font-size: 14px; color: #1565c0; font-weight: bold;">
                        📋 الإجراءات المطلوبة من إدارة الأوراق:
                    </p>
                    <ul style="margin: 5px 0; padding-right: 20px; font-size: 13px; color: #1976d2;">
                        <li style="margin: 5px 0;">استعجال جاهزية الأوراق</li>
                        <li style="margin: 5px 0;">إفادتنا بموعد الجاهزية</li>
                        <li style="margin: 5px 0;">التواصل مع العميل عند الجاهزية</li>
                    </ul>
                </div>

                <p style="margin: 20px 0px 10px 0px; padding: 10px; font-size: 14px; font-weight: bold; color: #ffffff; background-color: #ff9800; border-radius: 4px; text-align: center;">
                    ⚠️ يتطلب تدخل من HR وإدارة الأوراق
                </p>

                <div style="margin: 20px 0px; text-align: center;">
                    <a href="/web#id={{object.id}}&amp;model=res.complaint&amp;view_type=form"
                        style="padding: 10px 20px; font-size: 14px; color: #FFFFFF; background-color: #ff9800; border: none; border-radius: 4px; text-decoration: none; display: inline-block; font-weight: bold;">
                        عرض تفاصيل الشكوى
                    </a>
                </div>

                <p style="margin: 20px 0px 0px 0px; padding: 0px; font-size: 13px; color: #666;">
                    مع خالص التحية والتقدير،
                    <br />
                    <t t-esc="object.create_uid.name or 'نظام إدارة الشكاوى'" />
                </p>

                <hr style="border: none; border-top: 1px solid #e0e0e0; margin: 20px 0;" />

                <p style="margin: 0px; padding: 0px; font-size: 11px; color: #999; text-align: center;">
                    هذه رسالة تلقائية من نظام إدارة الشكاوى - يرجى عدم الرد على هذا البريد مباشرة
                </p>
            </div>
        </field>
        <field name="auto_delete"
            eval="False" />
    </record>
</odoo>
