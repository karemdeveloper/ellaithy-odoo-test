<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Document Readiness Inquiry Complaint Email Template (Arabic) -->
    <record id="email_template_complaint_doc_readiness_inquiry" model="mail.template">
        <field name="name">Complaint: Document Readiness Inquiry (Arabic)</field>
        <field name="model_id" ref="model_res_complaint"/>
        <field name="subject">افادة في جاهزية اوراق</field>
        <field name="email_from">{{(object.create_uid.email_formatted or user.email_formatted) or ''}}</field>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; direction: rtl; text-align: right; font-family: Arial, sans-serif;">
    <p style="margin: 0px; padding: 0px; font-size: 14px; font-weight: bold;">
        السادة ادارة الاوراق
        <br/><br/>
        تحية طيبة وبعد ,,,
        <br/><br/>
    </p>
    
    <p style="margin: 10px 0px; padding: 0px; font-size: 14px; line-height: 1.8;">
        وردنا اتصال من العميل لاحق الذكر يستفسر عن موعد جاهزية الاوراق 
        حيث ان المعاد المتوقع هو <strong style="color: #1976d2;">.....</strong>
        <br/><br/>
        <strong style="color: #2196f3;">فبرجاء الافادة بموعد الجاهزية لابلاغ العميل.</strong>
    </p>
    
    <div style="background-color: #e3f2fd; padding: 15px; border-right: 4px solid #2196f3; margin: 20px 0; border-radius: 4px;">
        <p style="margin: 0; font-weight: bold; color: #1565c0; font-size: 15px;">بيانات الاستفسار</p>
        <table style="width: 100%; margin-top: 10px; font-size: 13px;">
            <tr>
                <td style="padding: 5px; font-weight: bold; width: 40%;">رقم الشكوى:</td>
                <td style="padding: 5px;">{{object.name or ''}}</td>
            </tr>
            <tr>
                <td style="padding: 5px; font-weight: bold;">اسم العميل:</td>
                <td style="padding: 5px;">{{object.customer_id.name or 'غير محدد'}}</td>
            </tr>
            <tr>
                <td style="padding: 5px; font-weight: bold;">رقم الهاتف:</td>
                <td style="padding: 5px;">{{object.primary_phone or 'غير محدد'}}</td>
            </tr>
            <tr>
                <td style="padding: 5px; font-weight: bold;">مسؤول المبيعات:</td>
                <td style="padding: 5px;">{{object.salesperson_id.name or 'غير محدد'}}</td>
            </tr>
            <tr>
                <td style="padding: 5px; font-weight: bold;">الفرع:</td>
                <td style="padding: 5px;">{{object.branch_id.name or 'غير محدد'}}</td>
            </tr>
            <tr>
                <td style="padding: 5px; font-weight: bold;">القسم:</td>
                <td style="padding: 5px;">{{object.department.name or 'غير محدد'}}</td>
            </tr>
            <tr>
                <td style="padding: 5px; font-weight: bold;">تاريخ الاستفسار:</td>
                <td style="padding: 5px;">{{format_date(object.date) or 'غير محدد'}}</td>
            </tr>
            <tr>
                <td style="padding: 5px; font-weight: bold;">تاريخ الإبلاغ:</td>
                <td style="padding: 5px;">{{format_datetime(object.create_date, tz='Africa/Cairo', dt_format='dd/MM/yyyy - hh:mm a') if object.create_date else 'غير محدد'}}</td>
            </tr>
            <tr style="background-color: #bbdefb;">
                <td style="padding: 5px; font-weight: bold;">الموعد المتوقع:</td>
                <td style="padding: 5px; font-weight: bold;">.....</td>
            </tr>
            <tr>
                <td style="padding: 5px; font-weight: bold;">مدة الـ SLA:</td>
                <td style="padding: 5px;">{{object.sla_duration or 'غير محدد'}} يوم</td>
            </tr>
            <tr>
                <td style="padding: 5px; font-weight: bold;">سبب الاستفسار:</td>
                <td style="padding: 5px;">{{object.complaint_reason_id.name or 'غير محدد'}}</td>
            </tr>
            <tr>
                <td style="padding: 5px; font-weight: bold;">نوع الاستفسار:</td>
                <td style="padding: 5px; font-weight: bold;">استفسار عن جاهزية أوراق</td>
            </tr>
        </table>
    </div>
    
    <div style="background-color: #e8f5e9; padding: 15px; border-right: 3px solid #4caf50; margin: 15px 0; border-radius: 4px;">
        <p style="margin: 0 0 10px 0; font-size: 14px; color: #2e7d32; font-weight: bold;">
            ✅ الإجراءات المطلوبة:
        </p>
        <ul style="margin: 5px 0; padding-right: 20px; font-size: 13px; color: #1b5e20;">
            <li style="margin: 5px 0;">التحقق من موقف الأوراق</li>
            <li style="margin: 5px 0;">تحديد موعد الجاهزية الفعلي</li>
            <li style="margin: 5px 0;">إفادتنا بالموعد المحدد</li>
            <li style="margin: 5px 0;">إبلاغ العميل بالموعد</li>
            <li style="margin: 5px 0;">إخطارنا عند جاهزية الأوراق</li>
        </ul>
    </div>
    
    <div style="background-color: #fff8e1; padding: 12px; border-right: 3px solid #ffc107; margin: 15px 0; border-radius: 4px;">
        <p style="margin: 0; font-size: 13px; color: #f57c00;">
            <strong>📅 ملاحظة:</strong> العميل يستفسر عن الموعد المتوقع - يرجى الإفادة بموعد محدد
        </p>
    </div>
    
    <p style="margin: 20px 0px 10px 0px; padding: 0px; font-size: 14px; font-weight: bold; color: #2196f3;">
        📄 يرجى الإفادة بموعد جاهزية الأوراق لإبلاغ العميل
    </p>
    
    <div style="margin: 20px 0px; text-align: center;">
        <a href="/web#id={{object.id}}&amp;model=res.complaint&amp;view_type=form"
           style="padding: 10px 20px; font-size: 14px; color: #FFFFFF; background-color: #2196f3; border: none; border-radius: 4px; text-decoration: none; display: inline-block; font-weight: bold;">
            عرض تفاصيل الاستفسار
        </a>
    </div>
    
    <p style="margin: 20px 0px 0px 0px; padding: 0px; font-size: 13px; color: #666;">
        مع خالص التحية والتقدير،
        <br/>
        <strong>{{object.create_uid.name or 'نظام إدارة الشكاوى'}}</strong>
    </p>
    
    <hr style="border: none; border-top: 1px solid #e0e0e0; margin: 20px 0;"/>
    
    <p style="margin: 0px; padding: 0px; font-size: 11px; color: #999; text-align: center;">
        هذه رسالة تلقائية من نظام إدارة الشكاوى - يرجى عدم الرد على هذا البريد مباشرة
    </p>
</div>
        </field>
        <field name="auto_delete" eval="False"/>
    </record>
</odoo>
