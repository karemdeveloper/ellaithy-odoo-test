<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_ibs_payroll_officer" model="res.groups">
            <field name="name">Payroll Officer</field>
            <field name="category_id" ref="ellithy_hr_base.module_category_ellithy_hr"/>
            <field name="implied_ids" eval="[(4, ref('ellithy_hr_base.group_ellithy_hr_personnel'))]"/>
        </record>

        <record id="group_ibs_payroll_manager" model="res.groups">
            <field name="name">Payroll Manager</field>
            <field name="category_id" ref="ellithy_hr_base.module_category_ellithy_hr"/>
            <field name="implied_ids" eval="[(4, ref('group_ibs_payroll_officer'))]"/>
        </record>

        <!--
            CR 2.13: administrative penalties are approved by a named group
            rather than by whoever happens to hold HR Personnel. Membership is
            assigned per approver from Settings > Users.

            It implies HR Personnel so an approver can open the record it is
            asked to approve, and Payroll Manager implies it so payroll is
            never blocked waiting for a separate assignment.
        -->
        <record id="group_ibs_admin_penalty_approver" model="res.groups">
            <field name="name">Administrative Penalty Approver</field>
            <field name="category_id" ref="ellithy_hr_base.module_category_ellithy_hr"/>
            <field name="implied_ids" eval="[(4, ref('ellithy_hr_base.group_ellithy_hr_personnel'))]"/>
        </record>

        <record id="rule_warning_branch" model="ir.rule">
            <field name="name">Warning: own branch</field>
            <field name="model_id" ref="model_ibs_hr_warning"/>
            <field name="domain_force">[('branch_id', '=', user.employee_id.branch_id.id)]</field>
            <field name="groups" eval="[(4, ref('ellithy_hr_base.group_ellithy_hr_branch_manager'))]"/>
        </record>

        <record id="rule_warning_hr" model="ir.rule">
            <field name="name">Warning: HR sees all</field>
            <field name="model_id" ref="model_ibs_hr_warning"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('ellithy_hr_base.group_ellithy_hr_personnel'))]"/>
        </record>
    </data>
</odoo>
