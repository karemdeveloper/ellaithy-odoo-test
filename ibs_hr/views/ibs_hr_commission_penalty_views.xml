<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ibs_hr_commission_penalty_view_list" model="ir.ui.view">
        <field name="name">ibs.hr.commission.penalty.list</field>
        <field name="model">ibs.hr.commission.penalty</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="employee_id"/><field name="branch_id"/><field name="percentage"/><field name="reason_id"/><field name="date"/><field name="execution_date"/><field name="approval_status"/></list></field>
    </record>
    <record id="ibs_hr_commission_penalty_view_form" model="ir.ui.view">
        <field name="name">ibs.hr.commission.penalty.form</field>
        <field name="model">ibs.hr.commission.penalty</field>
        <field name="arch" type="xml">
            <form>
            <header>
                <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="approval_status != 'pending'" groups="ibs_hr.group_ibs_admin_penalty_approver"/>
                <button name="action_reject" type="object" string="Reject" invisible="approval_status != 'pending'" groups="ibs_hr.group_ibs_admin_penalty_approver"/>
                <button name="action_cancel" type="object" string="Cancel" invisible="approval_status not in ('pending', 'approved')" groups="ibs_hr.group_ibs_admin_penalty_approver"/>
                <button name="action_reset" type="object" string="Reset" invisible="approval_status not in ('rejected', 'cancel')" groups="ibs_hr.group_ibs_admin_penalty_approver"/>
                <field name="approval_status" widget="statusbar"/>
            </header><sheet>
                <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                <group>
                    <group><field name="employee_id"/><field name="branch_id"/><field name="date"/><field name="execution_date"/></group>
                    <group><field name="reason_id" required="1" options="{'no_create': True}"/><field name="percentage"/></group>
                </group>
                <group string="Review"><field name="reviewed_by"/><field name="reviewed_at"/>
                    <field name="rejection_reason" placeholder="Required to reject or cancel"/></group>
                <field name="note" placeholder="Note"/>
            </sheet>
            <chatter/></form></field>
    </record>
    <record id="ibs_hr_commission_penalty_view_search" model="ir.ui.view">
        <field name="name">ibs.hr.commission.penalty.search</field>
        <field name="model">ibs.hr.commission.penalty</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="reason_id"/>
                <field name="branch_id"/>
                <filter name="pending" string="Pending" domain="[('approval_status', '=', 'pending')]"/>
                <filter name="approved" string="Approved" domain="[('approval_status', '=', 'approved')]"/>
                <separator/>
                <filter name="this_year" string="This Year"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-01-01'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_reason" string="Reason" context="{'group_by': 'reason_id'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ibs_hr_commission_penalty_view_pivot" model="ir.ui.view">
        <field name="name">ibs.hr.commission.penalty.pivot</field>
        <field name="model">ibs.hr.commission.penalty</field>
        <field name="arch" type="xml">
            <pivot string="Commission Penalties by Reason">
                <field name="reason_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="percentage" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="ibs_hr_commission_penalty_view_graph" model="ir.ui.view">
        <field name="name">ibs.hr.commission.penalty.graph</field>
        <field name="model">ibs.hr.commission.penalty</field>
        <field name="arch" type="xml">
            <graph string="Commission Penalties by Reason" type="bar">
                <field name="reason_id"/>
            </graph>
        </field>
    </record>

    <record id="ibs_hr_commission_penalty_action" model="ir.actions.act_window">
        <field name="name">Commission Penalties</field>
        <field name="res_model">ibs.hr.commission.penalty</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>

    <!-- HR letter item 24: the managed list of reasons -->
    <record id="ibs_hr_commission_penalty_reason_view_list" model="ir.ui.view">
        <field name="name">ibs.hr.commission.penalty.reason.list</field>
        <field name="model">ibs.hr.commission.penalty.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="default_percentage"/>
                <field name="description" optional="show"/>
                <field name="penalty_count" string="Penalties"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="ibs_hr_commission_penalty_reason_action" model="ir.actions.act_window">
        <field name="name">Commission Penalty Reasons</field>
        <field name="res_model">ibs.hr.commission.penalty.reason</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
