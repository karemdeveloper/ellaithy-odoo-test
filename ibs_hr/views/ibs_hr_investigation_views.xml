<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ibs_hr_investigation_view_list" model="ir.ui.view">
        <field name="name">ibs.hr.investigation.list</field>
        <field name="model">ibs.hr.investigation</field>
        <field name="arch" type="xml"><list><field name="reference"/><field name="name"/><field name="date"/><field name="employee_count"/><field name="state"/></list></field>
    </record>
    <record id="ibs_hr_investigation_view_form" model="ir.ui.view">
        <field name="name">ibs.hr.investigation.form</field>
        <field name="model">ibs.hr.investigation</field>
        <field name="arch" type="xml"><form><header>
                <button name="action_open" type="object" string="Open" class="btn-primary" invisible="state != 'draft'"/>
                <button name="action_close" type="object" string="Close" class="btn-primary" invisible="state != 'open'"/>
                <button name="action_reset" type="object" string="Reset" invisible="state == 'draft'"/>
                <field name="state" widget="statusbar"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <label for="name"/><h1><field name="name" placeholder="Investigation title"/></h1>
                </div>
                <group>
                    <group><field name="reference" readonly="1"/><field name="date"/></group>
                    <group><field name="employee_count"/></group>
                </group>
                <notebook>
                    <page string="Employees" name="employees">
                        <field name="employee_ids">
                            <list editable="bottom">
                                <field name="employee_id"/>
                                <field name="branch_id"/>
                                <field name="result"/>
                            </list>
                        </field>
                    </page>
                    <page string="Detail" name="detail">
                        <group>
                            <field name="reason" placeholder="Why was this opened?"/>
                            <field name="result" placeholder="Findings"/>
                            <field name="action_taken" placeholder="Action taken"/>
                            <field name="notes"/>
                        </group>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </page>
                </notebook>
            </sheet>
            <chatter/></form></field>
    </record>
    <record id="ibs_hr_investigation_action" model="ir.actions.act_window">
        <field name="name">Investigations</field>
        <field name="res_model">ibs.hr.investigation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
