<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ibs_hr_permission_view_list" model="ir.ui.view">
        <field name="name">ibs.hr.permission.list</field>
        <field name="model">ibs.hr.permission</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="kind"/><field name="employee_id"/><field name="branch_id"/><field name="issue_date"/><field name="start_time"/><field name="end_time"/><field name="duration_hours"/><field name="destination"/><field name="state"/></list></field>
    </record>
    <record id="ibs_hr_permission_view_form" model="ir.ui.view">
        <field name="name">ibs.hr.permission.form</field>
        <field name="model">ibs.hr.permission</field>
        <field name="arch" type="xml">
            <form><header>
                <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'pending'"/>
                <button name="action_reject" type="object" string="Reject" invisible="state != 'pending'"/>
                <button name="action_cancel" type="object" string="Cancel" invisible="state in ('cancelled','draft')"/>
                <button name="action_reset" type="object" string="Reset" invisible="state == 'draft'"/>
                <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved"/>
            </header>
            <sheet>
                <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                <group>
                    <group>
                        <field name="kind"/>
                        <field name="employee_id"/>
                        <field name="branch_id"/>
                        <field name="department_id"/>
                        <field name="referred_by"/>
                    </group>
                    <group>
                        <field name="issue_date"/>
                        <field name="start_time" widget="float_time"/>
                        <field name="end_time" widget="float_time"/>
                        <field name="duration_hours" widget="float_time"/>
                    </group>
                </group>
                <group string="Mission Detail" invisible="kind != 'mission'">
                    <field name="destination" required="kind == 'mission'"/>
                    <field name="location"/>
                </group>
                <group>
                    <field name="reasons" placeholder="Reason for the request"/>
                    <field name="admin_remark" placeholder="Admin remark"/>
                </group>
            </sheet>
            <chatter/></form></field>
    </record>
    <record id="ibs_hr_permission_action" model="ir.actions.act_window">
        <field name="name">Permissions</field>
        <field name="res_model">ibs.hr.permission</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('kind', '=', 'permission')]</field>
        <field name="context">{'default_kind': 'permission'}</field>
    </record>
    <record id="ibs_hr_mission_action" model="ir.actions.act_window">
        <field name="name">Missions</field>
        <field name="res_model">ibs.hr.permission</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('kind', '=', 'mission')]</field>
        <field name="context">{'default_kind': 'mission'}</field>
    </record>
    <record id="ibs_hr_permission_view_search" model="ir.ui.view">
        <field name="name">ibs.hr.permission.search</field>
        <field name="model">ibs.hr.permission</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="branch_id"/>
                <field name="destination"/>
                <filter name="f_pending" string="Pending" domain="[('state','=','pending')]"/>
                <filter name="f_approved" string="Approved" domain="[('state','=','approved')]"/>
                <separator/>
                <filter name="f_permission" string="Permissions" domain="[('kind','=','permission')]"/>
                <filter name="f_mission" string="Missions" domain="[('kind','=','mission')]"/>
                <group expand="0" string="Group By">
                    <filter name="g_employee" string="Employee" context="{'group_by':'employee_id'}"/>
                    <filter name="g_branch" string="Branch" context="{'group_by':'branch_id'}"/>
                    <filter name="g_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="g_date" string="Date" context="{'group_by':'issue_date'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
