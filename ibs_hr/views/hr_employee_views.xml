<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_ibs" model="ir.ui.view">
        <field name="name">hr.employee.form.ibs</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_warnings" type="object"
                        class="oe_stat_button" icon="fa-gavel"
                        groups="ellithy_hr_base.group_ellithy_hr_branch_manager">
                    <field name="warning_count" widget="statinfo"
                           string="Violations"/>
                </button>
                <button name="action_view_investigations" type="object"
                        class="oe_stat_button" icon="fa-search"
                        groups="ellithy_hr_base.group_ellithy_hr_personnel">
                    <field name="investigation_count" widget="statinfo"
                           string="Investigations"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
