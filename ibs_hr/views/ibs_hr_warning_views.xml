<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ibs_hr_warning_view_list" model="ir.ui.view">
        <field name="name">ibs.hr.warning.list</field>
        <field name="model">ibs.hr.warning</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="employee_id"/><field name="branch_id"/><field name="violation_id"/><field name="date"/><field name="occurrence"/><field name="action"/><field name="penalty_days"/><field name="deducted_amount"/><field name="status"/></list></field>
    </record>
    <record id="ibs_hr_warning_view_form" model="ir.ui.view">
        <field name="name">ibs.hr.warning.form</field>
        <field name="model">ibs.hr.warning</field>
        <field name="arch" type="xml">
            <form><header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="status != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="status != 'pending'"/>
                    <button name="action_reject" type="object" string="Reject" invisible="status != 'pending'"/>
                    <button name="action_reset_draft" type="object" string="Reset" invisible="status == 'draft'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,pending,approved"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="branch_id"/>
                            <field name="violation_id"/>
                            <field name="date"/>
                            <field name="giver_id"/>
                        </group>
                        <group>
                            <field name="occurrence"/>
                            <field name="penalty_id"/>
                            <field name="action"/>
                            <field name="penalty_days"/>
                            <field name="custom_penalty_days"/>
                            <field name="deducted_amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="payslip_id"/>
                        </group>
                    </group>
                    <group string="Review">
                        <field name="reviewed_by"/><field name="reviewed_at"/>
                        <field name="review_comment"/>
                    </group>
                    <field name="notes" placeholder="Notes"/>
                </sheet>
                <chatter/></form>
        </field>
    </record>
    <record id="ibs_hr_warning_action" model="ir.actions.act_window">
        <field name="name">Warnings</field>
        <field name="res_model">ibs.hr.warning</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
