<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ibs_hr_payslip_view_list" model="ir.ui.view">
        <field name="name">ibs.hr.payslip.list</field>
        <field name="model">ibs.hr.payslip</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="employee_id"/><field name="branch_id"/><field name="salary_year"/><field name="salary_month"/><field name="base_salary"/><field name="total_allowance"/><field name="total_deduction"/><field name="net_salary"/><field name="state"/></list></field>
    </record>
    <record id="ibs_hr_payslip_view_form" model="ir.ui.view">
        <field name="name">ibs.hr.payslip.form</field>
        <field name="model">ibs.hr.payslip</field>
        <field name="arch" type="xml">
            <form><header>
                    <button name="action_compute" type="object" string="Compute" class="btn-primary" invisible="state in ('confirmed','paid')"/>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'computed'"/>
                    <button name="action_mark_paid" type="object" string="Mark Paid" invisible="state != 'confirmed'"/>
                    <button name="action_reset" type="object" string="Reset to Draft" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,computed,confirmed,paid"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group><field name="employee_id"/><field name="branch_id"/><field name="department_id"/>
                               <field name="contract_id"/></group>
                        <group><field name="salary_year"/><field name="salary_month"/>
                               <field name="date_from"/><field name="date_to"/>
                               <field name="calculation_days"/><field name="daily_rate"/>
                               <field name="currency_id" invisible="1"/></group>
                    </group>
                    <notebook>
                        <page string="Allowances" name="allowances">
                            <group>
                                <group>
                                    <field name="base_salary"/><field name="overtime"/>
                                    <field name="transportation_allowance"/><field name="bonus"/>
                                    <field name="kpi"/><field name="other_allowance"/>
                                </group>
                                <group string="Recorded, not summed">
                                    <field name="joining_difference"/>
                                    <field name="resignation_difference"/>
                                </group>
                            </group>
                            <group class="oe_subtotal_footer">
                                <field name="total_allowance"/>
                            </group>
                        </page>
                        <page string="Deductions" name="deductions">
                            <group>
                                <group string="Attendance">
                                    <field name="absence_days"/><field name="absence_penalty"/>
                                    <field name="late_penalty"/><field name="early_leave_penalty"/>
                                    <field name="unachieved_hours_penalty"/>
                                    <field name="single_fingerprint_penalty"/>
                                    <field name="deduction_leave"/>
                                </group>
                                <group string="Other">
                                    <field name="misconduct_penalty"/><field name="admin_penalty"/>
                                    <field name="loan"/><field name="insurance_employee_share"/>
                                    <field name="mobile_deduction"/><field name="medical_deduction"/>
                                    <field name="id_card_deduction"/><field name="extra_deduction"/>
                                </group>
                            </group>
                            <group class="oe_subtotal_footer">
                                <field name="total_deduction"/>
                                <field name="net_salary" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Sources" name="sources">
                            <separator string="Penalties Applied"/>
                            <field name="warning_ids" readonly="1">
                                <list><field name="name"/><field name="violation_id"/><field name="date"/>
                                      <field name="occurrence"/><field name="deducted_amount"/></list>
                            </field>
                            <separator string="Loan Instalments"/>
                            <field name="loan_line_ids" readonly="1">
                                <list><field name="loan_id"/><field name="date"/><field name="amount"/><field name="state"/></list>
                            </field>
                            <separator string="Computation Log"/>
                            <field name="compute_log" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/></form>
        </field>
    </record>
    <record id="ibs_hr_payslip_action" model="ir.actions.act_window">
        <field name="name">Payslips</field>
        <field name="res_model">ibs.hr.payslip</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="ibs_hr_payslip_batch_view_form" model="ir.ui.view">
        <field name="name">ibs.hr.payslip.batch.form</field>
        <field name="model">ibs.hr.payslip.batch</field>
        <field name="arch" type="xml">
            <form string="Generate Payslips">
                <group>
                    <group><field name="salary_year"/><field name="salary_month"/><field name="calculation_days"/></group>
                    <group><field name="branch_id"/><field name="department_id"/></group>
                </group>
                <field name="employee_ids" widget="many2many_tags" placeholder="Leave empty for all matching employees"/>
                <footer>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="ibs_hr_payslip_batch_action" model="ir.actions.act_window">
        <field name="name">Generate Payslips</field>
        <field name="res_model">ibs.hr.payslip.batch</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
