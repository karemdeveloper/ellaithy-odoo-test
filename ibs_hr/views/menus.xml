<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The standalone "Payroll Flow" root is gone: payroll is Odoo's own app
        now, and everything else hangs off the section menus that
        ellithy_hr_base defines under the Employees root.
    -->

    <!-- ============ Time &amp; Attendance ============ -->
    <menuitem id="menu_ta_attendance_days"
              name="Attendance Days"
              parent="ellithy_hr_base.menu_time_attendance"
              action="ibs_hr_attendance_day_action"
              sequence="20"/>

    <menuitem id="menu_ta_permissions"
              name="Permissions"
              parent="ellithy_hr_base.menu_time_attendance"
              action="ibs_hr_permission_action"
              sequence="40"/>

    <menuitem id="menu_ta_missions"
              name="Missions"
              parent="ellithy_hr_base.menu_time_attendance"
              action="ibs_hr_mission_action"
              sequence="50"/>

    <!-- ============ Conduct ============ -->
    <menuitem id="menu_conduct_penalties"
              name="Penalties"
              parent="ellithy_hr_base.menu_conduct"
              action="ibs_hr_warning_action"
              sequence="20"/>

    <menuitem id="menu_conduct_admin_penalties"
              name="Admin &amp; Day Penalties"
              parent="ellithy_hr_base.menu_conduct"
              action="ibs_hr_admin_penalty_record_action"
              sequence="40"/>

    <menuitem id="menu_conduct_commission_penalties"
              name="Commission Penalties"
              parent="ellithy_hr_base.menu_conduct"
              action="ibs_hr_commission_penalty_action"
              sequence="50"/>

    <menuitem id="menu_conduct_investigations"
              name="Investigations"
              parent="ellithy_hr_base.menu_conduct"
              action="ibs_hr_investigation_action"
              sequence="60"/>

    <!-- ============ Configuration &gt; Discipline ============ -->
    <menuitem id="menu_cfg_discipline"
              name="Discipline"
              parent="hr.menu_human_resources_configuration"
              sequence="40"
              groups="ellithy_hr_base.group_ellithy_hr_admin"/>

    <menuitem id="menu_cfg_violations"
              name="Penalty Catalogue"
              parent="menu_cfg_discipline"
              action="ibs_hr_violation_action"
              sequence="10"/>

    <menuitem id="menu_cfg_admin_penalty_types"
              name="Admin Penalty Types"
              parent="menu_cfg_discipline"
              action="ibs_hr_admin_penalty_action"
              sequence="20"/>
</odoo>
