<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ibs_hr_loan_view_list" model="ir.ui.view">
        <field name="name">ibs.hr.loan.list</field>
        <field name="model">ibs.hr.loan</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="employee_id"/><field name="date"/><field name="is_advance"/><field name="amount"/><field name="months"/><field name="installment_amount"/><field name="paid_amount"/><field name="balance"/><field name="state"/></list></field>
    </record>
    <record id="ibs_hr_loan_view_form" model="ir.ui.view">
        <field name="name">ibs.hr.loan.form</field>
        <field name="model">ibs.hr.loan</field>
        <field name="arch" type="xml">
            <form><header>
                    <button name="action_approve" type="object" string="Approve &amp; Schedule" class="btn-primary" invisible="state not in ('draft','pending')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('cancel','done')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group><field name="employee_id"/><field name="date"/><field name="is_advance"/></group>
                        <group><field name="amount"/><field name="months"/><field name="installment_amount"/>
                               <field name="paid_amount"/><field name="balance"/>
                               <field name="currency_id" invisible="1"/></group>
                    </group>
                    <separator string="Repayment Schedule"/>
                    <field name="line_ids">
                        <list>
                            <field name="sequence"/><field name="date"/><field name="amount"/>
                            <field name="state"/><field name="payslip_id"/>
                        </list>
                    </field>
                </sheet>
                <chatter/></form>
        </field>
    </record>
    <record id="ibs_hr_loan_action" model="ir.actions.act_window">
        <field name="name">Loans &amp; Advances</field>
        <field name="res_model">ibs.hr.loan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
