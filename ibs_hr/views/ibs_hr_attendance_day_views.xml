<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ibs_hr_attendance_day_view_list" model="ir.ui.view">
        <field name="name">ibs.hr.attendance.day.list</field>
        <field name="model">ibs.hr.attendance.day</field>
        <field name="arch" type="xml">
            <list><field name="date"/><field name="employee_id"/><field name="branch_id"/><field name="state"/><field name="check_in"/><field name="check_out"/><field name="worked_hours"/><field name="scheduled_hours"/><field name="shortfall_hours"/><field name="late_minutes"/><field name="early_leave_minutes"/><field name="overtime_hours"/><field name="single_punch"/><field name="absence_days"/></list></field>
    </record>
    <record id="ibs_hr_attendance_day_view_form" model="ir.ui.view">
        <field name="name">ibs.hr.attendance.day.form</field>
        <field name="model">ibs.hr.attendance.day</field>
        <field name="arch" type="xml">
            <form><sheet><group>
                    <group>
                        <field name="employee_id"/><field name="date"/><field name="state"/>
                        <field name="branch_id"/><field name="is_paid_leave"/>
                    </group>
                    <group>
                        <field name="check_in"/><field name="check_out"/>
                        <field name="scheduled_hours"/><field name="worked_hours"/>
                        <field name="shortfall_hours"/><field name="overtime_hours"/>
                        <field name="late_minutes"/><field name="early_leave_minutes"/>
                        <field name="single_punch"/><field name="absence_days"/>
                    </group>
                </group></sheet></form>
        </field>
    </record>
    <record id="ibs_hr_attendance_day_action" model="ir.actions.act_window">
        <field name="name">Attendance Days</field>
        <field name="res_model">ibs.hr.attendance.day</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
