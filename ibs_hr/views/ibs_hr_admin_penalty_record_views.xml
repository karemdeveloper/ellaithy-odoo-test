<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ibs_hr_admin_penalty_record_view_list" model="ir.ui.view">
        <field name="name">ibs.hr.admin.penalty.record.list</field>
        <field name="model">ibs.hr.admin.penalty.record</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="employee_id"/><field name="branch_id"/><field name="penalty_id"/><field name="date"/><field name="name_snapshot"/><field name="cost_snapshot"/><field name="custom_cost"/><field name="amount"/><field name="giver_id"/><field name="approval_status"/></list></field>
    </record>
    <record id="ibs_hr_admin_penalty_record_view_form" model="ir.ui.view">
        <field name="name">ibs.hr.admin.penalty.record.form</field>
        <field name="model">ibs.hr.admin.penalty.record</field>
        <field name="arch" type="xml"><form><header>
                <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="approval_status != 'pending'"/>
                <button name="action_reject" type="object" string="Reject" invisible="approval_status != 'pending'"/>
                <button name="action_reset" type="object" string="Reset" invisible="approval_status == 'pending'"/>
                <field name="approval_status" widget="statusbar"/>
            </header>
            <sheet>
                <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                <group>
                    <group>
                        <field name="employee_id"/><field name="branch_id"/>
                        <field name="penalty_id"/><field name="date"/>
                        <field name="giver_id"/>
                    </group>
                    <group>
                        <field name="name_snapshot"/><field name="cost_snapshot"/>
                        <field name="custom_cost"/><field name="amount"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="payslip_id"/>
                    </group>
                </group>
                <group string="Review">
                    <field name="approved_by"/><field name="approved_at"/>
                    <field name="rejected_by"/><field name="rejected_at"/>
                    <field name="rejection_reason"/>
                </group>
                <field name="notes" placeholder="Notes"/>
                <field name="attachment_ids" widget="many2many_binary"/>
            </sheet>
            <chatter/></form></field>
    </record>
    <record id="ibs_hr_admin_penalty_record_action" model="ir.actions.act_window">
        <field name="name">Admin Penalties</field>
        <field name="res_model">ibs.hr.admin.penalty.record</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
