<odoo>
    <template id="ending_service_reward_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                     <div class="page">
                    <h2>End of Service Report</h2>
                    <p>
                        <strong>Employee:</strong>
                        <t t-esc="o.employee_id.name"/>
                    </p>
                    <p>
                        <strong>Department:</strong>
                        <t t-esc="o.department_id.name"/>
                    </p>
                    <p>
                        <strong>Nationality:</strong>
                        <t t-esc="o.country_id.name"/>
                    </p>
                    <p>
                        <strong>Hiring Date:</strong>
                        <t t-esc="o.hiring_date"/>
                    </p>
                    <p>
                        <strong>End Date:</strong>
                        <t t-esc="o.end_date"/>
                    </p>
                    <p>
                        <strong>Gross Salary:</strong>
                        <t t-esc="o.gross"/>
                    </p>
                    <p>
                        <strong>Allowances:</strong>
                        <t t-esc="o.allowances"/>
                    </p>
                    <p>
                        <strong>Working Days in Month:</strong>
                        <t t-esc="o.days_in_month"/>
                    </p>
                    <p>
                        <strong>Actual Working Days:</strong>
                        <t t-esc="o.actual_days"/>
                    </p>
                    <p>
                        <strong>Salary Due:</strong>
                        <t t-esc="o.salary_due"/>
                    </p>
                    <p>
                        <strong>Leave Allowance:</strong>
                        <t t-esc="o.leave_allowance"/>
                    </p>
                    <p>
                        <strong>Service Gratuity:</strong>
                        <t t-esc="o.service_gratuity"/>
                    </p>
                    <p>
                        <strong>Total Rewards:</strong>
                        <t t-esc="o.total_rewords"/>
                    </p>
                    <p>
                        <strong>Resignation Type:</strong>
                        <t t-esc="dict(o.fields_get()['type_resignation']['selection'])[o.type_resignation] if o.type_resignation else ''"/>
                    </p>
                    <t t-if="o.reason_grant">
                        <p>
                            <strong>Reason Grant:</strong>
                            <t t-foreach="o.reason_grant" t-as="grant">
                                <span class="badge badge-primary" style="margin-right:5px;">
                                    <t t-esc="grant.name"/>
                                </span>
                            </t>
                        </p>
                    </t>
                </div>
                </t>
            </t>
        </t>

    </template>

</odoo>
