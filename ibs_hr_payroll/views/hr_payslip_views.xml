<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payslip_form_hcm_roles" model="ir.ui.view">
        <field name="name">hr.payslip.form.hcm.roles</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll_community.hr_payslip_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_compute_sheet']" position="attributes">
                <attribute name="groups">ibs_hr_payroll.ibs_hr_payroll_generalist</attribute>
            </xpath>
            <xpath expr="//button[@name='action_payslip_done']" position="attributes">
                <attribute name="groups">ibs_hr_payroll.ibs_hr_payroll_finance</attribute>
                <attribute name="string">Finance Confirm</attribute>
            </xpath>
            <xpath expr="//button[@name='action_payslip_draft']" position="attributes">
                <attribute name="groups">ibs_hr_payroll.ibs_hr_payroll_admin</attribute>
            </xpath>
            <xpath expr="//button[@name='action_payslip_cancel']" position="attributes">
                <attribute name="groups">ibs_hr_payroll.ibs_hr_payroll_admin</attribute>
            </xpath>
        </field>
    </record>
</odoo>
