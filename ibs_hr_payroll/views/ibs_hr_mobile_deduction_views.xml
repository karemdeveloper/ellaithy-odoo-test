<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mobile_deduction_view_list" model="ir.ui.view">
        <field name="name">ibs.hr.mobile.deduction.list</field>
        <field name="model">ibs.hr.mobile.deduction</field>
        <field name="arch" type="xml"><list><field name="period"/><field name="employee_id"/>
            <field name="reference"/><field name="amount"/><field name="state"/><field name="payslip_id"/>
        </list></field>
    </record>
    <record id="mobile_deduction_view_form" model="ir.ui.view">
        <field name="name">ibs.hr.mobile.deduction.form</field>
        <field name="model">ibs.hr.mobile.deduction</field>
        <field name="arch" type="xml"><form><header>
            <button name="action_approve" type="object" groups="ibs_hr_payroll.ibs_hr_payroll_generalist" string="Approve" class="btn-primary" invisible="state != 'draft'"/>
            <button name="action_cancel" type="object" groups="ibs_hr_payroll.ibs_hr_payroll_generalist" string="Cancel" invisible="state not in ('draft', 'approved')"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,approved,deducted"/>
        </header><sheet><group><field name="employee_id"/><field name="period"/>
            <field name="reference"/><field name="amount"/><field name="payslip_id" readonly="1"/>
        </group></sheet></form></field>
    </record>
    <record id="mobile_deduction_action" model="ir.actions.act_window">
        <field name="name">Mobile Invoice Deductions</field>
        <field name="res_model">ibs.hr.mobile.deduction</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
