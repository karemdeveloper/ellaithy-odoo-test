<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_candidate_view_form_ellithy" model="ir.ui.view">
        <field name="name">hr.candidate.form.ellithy</field>
        <field name="model">hr.candidate</field>
        <field name="inherit_id" ref="hr_recruitment.hr_candidate_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_contacts" type="object" class="oe_stat_button" icon="fa-phone">
                    <field name="contact_count" widget="statinfo" string="Contacts"/>
                </button>
            </xpath>
            <field name="type_id" position="attributes">
                <attribute name="string">Educational Qualification</attribute>
            </field>
            <xpath expr="//notebook" position="inside">
                <page string="Personal &amp; Experience" name="ellithy_background">
                    <group>
                        <group string="Personal">
                            <field name="national_id"/>
                            <field name="birthdate"/>
                            <field name="marital_status"/>
                            <field name="military_status"/>
                            <field name="language_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Experience">
                            <field name="previous_job_title"/>
                            <field name="previous_experience_years"/>
                            <field name="notice_period_days"/>
                            <field name="previous_experience" placeholder="Previous employers, roles and duration"/>
                        </group>
                    </group>
                </page>
                <page string="Contact Log" name="ellithy_contacts">
                    <field name="contact_ids" context="{'default_candidate_id': id}">
                        <list editable="bottom">
                            <field name="date"/>
                            <field name="channel"/>
                            <field name="job_id"/>
                            <field name="result"/>
                            <field name="notes"/>
                            <field name="follow_up_date"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
