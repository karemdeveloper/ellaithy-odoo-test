<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_helpdesk_team_leadership" model="res.groups">
            <field name="name">Manager / Leader</field>
            <field name="category_id" ref="base.module_category_services_helpdesk"/>
            <field name="implied_ids" eval="[(4, ref('helpdesk.group_helpdesk_user'))]"/>
        </record>

        <record id="helpdesk.group_helpdesk_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_helpdesk_team_leadership'))]"/>
        </record>


        <record id="helpdesk.helpdesk_ticket_user_rule" model="ir.rule">
            <field name="name">Helpdesk Ticket: User (Own &amp; Assigned Only)</field>
            <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
            <field name="domain_force">[
                '|',
                ('create_uid', '=', user.id),
                ('user_id', '=', user.id)
                ]
            </field>
            <field name="groups" eval="[(4, ref('helpdesk.group_helpdesk_user'))]"/>
        </record>

        <!--        <record id="group_helpdesk_team_leadership_rule" model="ir.rule">-->
        <!--            <field name="name">Helpdesk Ticket: Team Leadership (Their Teams Only)</field>-->
        <!--            <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>-->
        <!--            <field name="domain_force">[-->
        <!--                '|',-->
        <!--                ('team_id.manager_id', '=', user.id),-->
        <!--                ('team_id.team_leader_id', '=', user.id)-->
        <!--                ]-->
        <!--            </field>-->
        <!--            <field name="groups" eval="[(4, ref('group_helpdesk_team_leadership'))]"/>-->
        <!--        </record>-->

        <record id="group_helpdesk_team_leadership_rule" model="ir.rule">
            <field name="name">Helpdesk Ticket: Team Leadership (Their Teams + Created by Team Members)</field>
            <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
            <field name="domain_force">[
                '|', '|',
                ('team_id.manager_id', '=', user.id),
                ('team_id.team_leader_id', '=', user.id),
                ('create_uid', 'in', user.env['helpdesk.team'].search(['|', ('manager_id', '=', user.id),
                ('team_leader_id', '=', user.id)]).member_ids.ids)
                ]
            </field>
            <field name="groups" eval="[(4, ref('group_helpdesk_team_leadership'))]"/>
        </record>


        <record id="helpdesk.helpdesk_ticket_manager_rule" model="ir.rule">
            <field name="name">Helpdesk Ticket: Administrator (All Teams)</field>
            <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('helpdesk.group_helpdesk_manager'))]"/>
        </record>

    </data>
</odoo>