    <record id="view_helpdesk_stage_form_inherit_custom" model="ir.ui.view">
        <field name="name">helpdesk.stage.form.inherit.custom</field>
        <field name="model">helpdesk.stage</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_stage_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='fold']" position="after">
                <!--                <field name="is_hold_stage"/>-->
                <!--                <field name="is_default_return_stage"/>-->
                <field name="is_escalation_stage"/>
                <field name="escalation_level" invisible="not is_escalation_stage"/>

            </xpath>

        </field>
    </record>


    <record id="view_helpdesk_ticket_form_inherit_ellithy_v3" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.inherit.ellithy.v3</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='team_id']" position="after">
                <field name="team_manager_id" invisible="1"/>
                <field name="team_leader_id" invisible="1"/>
                <field name="member_ids" invisible="1"/>
                <!--                <field name="hold_start_date" invisible="1"/>-->
                <field name="date_last_escalation" readonly="1"/>
                <field name="overdue_hr_sent" invisible="1"/>
                <field name="reminder_80_sent" invisible="1"/>
                <field name="task_type_id"
                       required="0"
                       options="{'no_create': True}"
                       domain="[('team_id', '=', team_id)]"/>

                <field name="expected_duration" widget="float_time" readonly="1" force_save="1"/>
                <field name="equipment_task_type"/>

                <!--                <field name="dependency_ticket_id"-->
                <!--                       options="{'no_create': True}"-->
                <!--                       domain="[('id', '!=', id), ('stage_id.fold', '=', False)]"-->
                <!--                       placeholder="Select ticket to wait for..."/>-->

                <!--                <label for="total_hold_duration" string="SLA Hold Time"-->
                <!--                       invisible="total_hold_duration == 0 and not hold_start_date"/>-->
                <!--                <div class="o_row" invisible="total_hold_duration == 0 and not hold_start_date">-->
                <!--                    <field name="total_hold_duration" widget="float_time" readonly="1" class="oe_inline"/>-->
                <!--                    <span invisible="not hold_start_date" class="badge rounded-pill text-bg-warning ms-2">-->
                <!--                        Currently On Hold-->
                <!--                    </span>-->
                <!--                </div>-->
            </xpath>

            <xpath expr="//field[@name='email_cc']" position="after">
                <field name="notes"/>
            </xpath>

            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="invisible">not team_id or (uid != team_manager_id and uid != team_leader_id)
                </attribute>
                <attribute name="domain">[('id', 'in', member_ids)]</attribute>
                <attribute name="required">team_id and uid == team_manager_id</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

            <xpath expr="//field[@name='stage_id']" position="attributes">
                <attribute name="options">{'clickable': '1'}</attribute>
                <attribute name="domain">
                    [('name', 'in', ['New', 'In Progress', 'Solved', 'Cancelled'])]
                </attribute>
            </xpath>
        </field>
    </record>
    <record id="view_helpdesk_team_form_inherit_manager_v2" model="ir.ui.view">
        <field name="name">helpdesk.team.form.inherit.manager.v2</field>
        <field name="model">helpdesk.team</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_team_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='member_ids']" position="after">
                <div class="mt16 d-flex" name="manager_id">
                    <label for="manager_id"/>
                    <field name="manager_id"
                           class="ms-3"
                           options="{'no_quick_create': True, 'no_create_edit': True}"/>
                </div>
                <div class="text-muted ms-5" invisible="not manager_id">
                    Manager of Team
                </div>

                <div class="mt16 d-flex" name="team_leader_id">
                    <label for="team_leader_id"/>
                    <field name="team_leader_id"
                           class="ms-3"
                           options="{'no_quick_create': True, 'no_create_edit': True}"/>
                </div>
                <div class="text-muted ms-5" invisible="not team_leader_id">
                    Secondary Leader of Team
                </div>
            </xpath>

        </field>
    </record>

    <record id="view_helpdesk_ticket_search_inherit_my_tickets" model="ir.ui.view">
        <field name="name">helpdesk.ticket.search.inherit.my.tickets</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_tickets_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_ticket']" position="after">
                <filter string="Created By Me" name="created_by_me" domain="[('create_uid', '=', uid)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_helpdesk_ticket_tree_inherit_created_by" model="ir.ui.view">
        <field name="name">helpdesk.ticket.tree.inherit.created.by</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_tickets_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='team_id']" position="after">
                <field name="create_uid" string="Created By" widget="many2one_avatar_user"/>
            </xpath>
        </field>
    </record>

    <record id="stage_first_reopen" model="helpdesk.stage">
        <field name="name">First Reopen</field>
        <field name="sequence">50</field>
    </record>

    <record id="stage_second_reopen" model="helpdesk.stage">
        <field name="name">Second Reopen</field>
        <field name="sequence">60</field>
    </record>


    <record id="stage_overdue" model="helpdesk.stage">
        <field name="name">Overdue</field>
        <field name="sequence">70</field>
    </record>

</odoo>

