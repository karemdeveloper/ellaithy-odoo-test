<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_course_lesson_list" model="ir.ui.view">
        <field name="name">course.lesson.list</field>
        <field name="model">course.lesson</field>
        <field name="arch" type="xml">
            <list default_order="course_id, sequence">
                <field name="sequence" widget="handle"/>
                <field name="title"/>
                <field name="course_id"/>
                <field name="video_type"/>
                <field name="duration"/>
                <field name="free_lesson"/>
            </list>
        </field>
    </record>

    <record id="view_course_lesson_form" model="ir.ui.view">
        <field name="name">course.lesson.form</field>
        <field name="model">course.lesson</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <field name="active" invisible="1"/>
                        <h1><field name="title" placeholder="Lesson Title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="course_id"/>
                            <field name="sequence"/>
                            <field name="duration"/>
                            <field name="free_lesson"/>
                        </group>
                        <group>
                            <field name="video_type"/>
                            <field name="video_url"
                                   invisible="video_type not in ('youtube', 'vimeo', 'url')"
                                   required="video_type in ('youtube', 'vimeo', 'url')"/>
                            <field name="video_file" filename="video_file_filename"
                                   invisible="video_type != 'uploaded'"
                                   required="video_type == 'uploaded'"/>
                            <field name="video_file_filename" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_course_lesson_search" model="ir.ui.view">
        <field name="name">course.lesson.search</field>
        <field name="model">course.lesson</field>
        <field name="arch" type="xml">
            <search>
                <field name="title"/>
                <field name="course_id"/>
                <filter string="Free Lessons" name="free" domain="[('free_lesson', '=', 'yes')]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Course" name="group_course" context="{'group_by': 'course_id'}"/>
                    <filter string="Video Type" name="group_video_type" context="{'group_by': 'video_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_course_lesson" model="ir.actions.act_window">
        <field name="name">Lessons</field>
        <field name="res_model">course.lesson</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_course': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first course lesson
            </p>
        </field>
    </record>

    <menuitem id="menu_course_lesson" name="Lessons" parent="menu_course_root"
              action="action_course_lesson" sequence="20"/>

</odoo>
