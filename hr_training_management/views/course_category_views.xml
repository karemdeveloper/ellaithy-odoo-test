<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_course_category_list" model="ir.ui.view">
        <field name="name">course.category.list</field>
        <field name="model">course.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="image" widget="image" options="{'size': [40, 40]}"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_course_category_form" model="ir.ui.view">
        <field name="name">course.category.form</field>
        <field name="model">course.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_subcategories" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="subcategory_count" widget="statinfo" string="Subcategories"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <field name="active" invisible="1"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_course_category_kanban" model="ir.ui.view">
        <field name="name">course.category.kanban</field>
        <field name="model">course.category</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="image"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <img t-att-src="kanban_image('course.category', 'image', record.id.raw_value)"
                                 class="o_kanban_image_fill_left rounded" alt="Category" width="48" height="48"/>
                            <strong><field name="name"/></strong>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_course_category_search" model="ir.ui.view">
        <field name="name">course.category.search</field>
        <field name="model">course.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_course_category" model="ir.actions.act_window">
        <field name="name">Course Categories</field>
        <field name="res_model">course.category</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first course category
            </p>
        </field>
    </record>

    <menuitem id="menu_course_root" name="Courses" sequence="76"/>
    <menuitem id="menu_course_config" name="Configuration" parent="menu_course_root" sequence="100"/>
    <menuitem id="menu_course_category" name="Categories" parent="menu_course_config"
              action="action_course_category" sequence="10"/>

</odoo>
