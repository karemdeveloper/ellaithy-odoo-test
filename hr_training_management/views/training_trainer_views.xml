<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_training_trainer_list" model="ir.ui.view">
        <field name="name">training.trainer.list</field>
        <field name="model">training.trainer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="training_type_ids" widget="many2many_tags"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="field_of_expertise"/>
            </list>
        </field>
    </record>

    <record id="view_training_trainer_form" model="ir.ui.view">
        <field name="name">training.trainer.form</field>
        <field name="model">training.trainer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="name"/>
                            <field name="training_type_ids" widget="many2many_tags"/>
                            <field name="field_of_expertise"/>
                        </group>
                        <group>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                        </group>
                    </group>
                    <group>
                        <field name="address"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_training_trainer_search" model="ir.ui.view">
        <field name="name">training.trainer.search</field>
        <field name="model">training.trainer</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="training_type_ids"/>
                <field name="field_of_expertise"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Training Type" name="group_type" context="{'group_by': 'training_type_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_training_trainer" model="ir.actions.act_window">
        <field name="name">Trainers</field>
        <field name="res_model">training.trainer</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_training_trainer" name="Trainers" parent="menu_training_root"
              action="action_training_trainer" sequence="20"/>

</odoo>
