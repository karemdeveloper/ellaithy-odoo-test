<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_assessment_invitation" model="mail.template">
            <field name="name">Training: Assessment Invitation</field>
            <field name="model_id" ref="model_training_assessment_attempt"/>
            <field name="subject">Assessment: {{ object.assessment_id.name }} / اختبار تدريبي</field>
            <field name="email_from">{{ (object.employee_id.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.employee_id.work_email }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div style="margin:0;padding:24px 0;background:#F4F5F7;font-family:Arial,Helvetica,sans-serif;">
                    <table align="center" cellpadding="0" cellspacing="0" border="0" width="600"
                           style="width:600px;max-width:600px;border-collapse:collapse;background:#FFFFFF;border-radius:6px;">
                        <tr><td style="background:#E4610F;color:#FFFFFF;padding:18px 28px;font-size:18px;font-weight:bold;">
                            <t t-out="object.assessment_id.name or ''">Assessment</t>
                        </td></tr>
                        <tr><td style="padding:24px 28px;font-size:15px;line-height:1.6;color:#333333;">
                            <p style="margin:0 0 12px 0;">Dear <t t-out="object.employee_id.name or ''">Trainee</t>,</p>
                            <p style="margin:0 0 12px 0;">Please answer the assessment for
                                <strong><t t-out="object.training_id.name or ''">the training</t></strong>.
                                The pass mark is <t t-out="int(object.assessment_id.pass_mark)">70</t> out of 100.</p>
                            <p dir="rtl" style="margin:0 0 18px 0;text-align:right;">برجاء الإجابة على الاختبار الخاص بالبرنامج التدريبي من خلال الرابط التالي.</p>
                            <a t-att-href="object.get_portal_url()"
                               style="display:inline-block;background:#E4610F;color:#FFFFFF;text-decoration:none;font-weight:bold;padding:12px 22px;border-radius:4px;">
                                Start the assessment / ابدأ الاختبار</a>
                        </td></tr>
                    </table>
                </div>
            </field>
        </record>
    </data>
</odoo>
