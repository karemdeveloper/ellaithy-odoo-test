<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_send_training_evaluations" model="ir.cron">
        <field name="name">Training: send evaluations after the programme ends</field>
        <field name="model_id" ref="model_training_training"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_evaluations()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
