<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Adding sequence to the HRMS modules root menu-->
    <data>
        <menuitem name="Recruitment"
                  id="hr_recruitment.menu_hr_recruitment_root"
                  web_icon="hr_recruitment,static/description/icon.png"
                  sequence="4"/>

        <!-- Explicitly clear parent_id: menuitem updates otherwise retain the
             parent set by the Attendance module, keeping it nested. -->
        <record id="hr_attendance.menu_hr_attendance_root" model="ir.ui.menu">
            <field name="name">Attendances</field>
            <field name="parent_id" eval="False"/>
            <field name="sequence">7</field>
            <field name="groups_id" eval="[(6, 0, [ref('hr_attendance.group_hr_attendance_own_reader')])]"/>
            <field name="web_icon">hr_attendance,static/description/icon.png</field>
        </record>


        <menuitem id="hr_payroll_community.menu_hr_payroll_community_root"
                  name="Payroll" sequence="11"
                  web_icon="hr_payroll_community,static/description/icon.png"/>

        <menuitem id="hr_expense.menu_hr_expense_root"
                  name="Expenses" sequence="12"
                  web_icon="hr_expense,static/description/icon.png"/>
    </data>
</odoo>
