<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        CR 2.7: resignation is handled on its own screen. The employee form
        gets a way in, not a copy of the fields.
    -->
    <record id="hr_employee_view_form_resignation" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.ellithy.resignation</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_resignations" type="object"
                        class="oe_stat_button" icon="fa-sign-out"
                        invisible="resignation_count == 0"
                        groups="hr.group_hr_user">
                    <field name="resignation_count" widget="statinfo"
                           string="Resignation"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
