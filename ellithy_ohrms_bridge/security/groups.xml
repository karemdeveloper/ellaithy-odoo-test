    <record id="ellithy_hr_base.group_ellithy_hr_admin" model="res.groups"><field name="implied_ids" eval="[(4, ref('resignation_admin'))]"/></record>
    <function model="res.groups" name="_ellithy_bind_module_roles">
        <value eval="'ellithy_ohrms_bridge'"/>
        <value eval="'loan'"/>
        <value eval="True"/>
    </function>
    <function model="res.groups" name="_ellithy_bind_module_roles">
        <value eval="'ellithy_ohrms_bridge'"/>
        <value eval="'advance'"/>
        <value eval="True"/>
    </function>
    <function model="res.groups" name="_ellithy_bind_module_roles">
        <value eval="'ellithy_ohrms_bridge'"/>
        <value eval="'resignation'"/>
        <value eval="False"/>
    </function>
</odoo>
