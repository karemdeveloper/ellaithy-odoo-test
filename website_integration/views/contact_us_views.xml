<odoo>

    <!-- Action -->
    <record id="action_contact_us" model="ir.actions.act_window">
        <field name="name">Contact Us</field>
        <field name="res_model">contact.us</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Submenu -->
    <menuitem id="menu_contact_us"
              name="Contact Us"
              parent="menu_integrations"
              action="action_contact_us"
              sequence="5"/>

    <!-- List view -->
    <record id="view_contact_us_list" model="ir.ui.view">
        <field name="name">contact.us.list</field>
        <field name="model">contact.us</field>
        <field name="arch" type="xml">
            <list string="Contact Uss">
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="phone"/>
                <field name="area"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_contact_us_form" model="ir.ui.view">
        <field name="name">contact.us.form</field>
        <field name="model">contact.us</field>
        <field name="arch" type="xml">
            <form string="Contact Us">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <!-- Customer Information -->
                    <group string="Customer Information" col="2">
                        <group>
                            <field name="first_name"/>
                            <field name="last_name"/>
                        </group>
                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="area"/>
                        </group>

                    </group>

                    <!-- Message -->
                    <group string="Additional Notes">
                        <field name="message"
                               placeholder="Write additional details or requests here..."/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

</odoo>


