<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            CR 2.5: the onboarding mail. Sent from a button on the employee
            form, through a wizard that renders this template so HR can read
            and edit it before it goes.

            Built as a table with inline styles because that is what mail
            clients render reliably: Outlook ignores most external CSS, flex
            and grid, so the layout is a single 600px centred table and every
            colour is stated on the element that uses it.

            The logo is pulled from the company record, so replacing it in
            Settings replaces it here with no change to this file.
        -->
        <record id="mail_template_employee_welcome" model="mail.template">
            <field name="name">Employee: Welcome / Onboarding</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="subject">Welcome to {{ object.company_id.name }}, {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.work_email }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div style="background:#F4F5F7;margin:0;padding:24px 0;">
                    <t t-set="base_url" t-value="object.env['ir.config_parameter'].sudo().get_param('web.base.url')"/>
                    <table align="center" cellpadding="0" cellspacing="0" border="0" width="600"
                           style="width:600px;max-width:600px;border-collapse:collapse;background:#FFFFFF;border-radius:6px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">

                        <!-- Orange band carrying the company logo -->
                        <tr>
                            <td style="background:#E4610F;padding:26px 32px;" align="left">
                                <table cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;">
                                    <tr>
                                        <td align="left" valign="middle">
                                            <img t-att-src="'%s/logo.png?company=%s' % (base_url, object.company_id.id or '')"
                                                 t-att-alt="object.company_id.name"
                                                 height="40"
                                                 style="height:40px;max-height:40px;width:auto;border:0;outline:none;display:block;background:#FFFFFF;padding:6px 10px;border-radius:4px;"/>
                                        </td>
                                        <td align="right" valign="middle"
                                            style="color:#FFFFFF;font-size:11px;letter-spacing:1.6px;text-transform:uppercase;font-family:Arial,Helvetica,sans-serif;">
                                            Welcome aboard
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                        <!-- Greeting -->
                        <tr>
                            <td style="padding:34px 32px 8px 32px;">
                                <h1 style="margin:0 0 14px 0;font-size:24px;line-height:1.25;color:#1A1A1A;font-family:Arial,Helvetica,sans-serif;font-weight:bold;">
                                    Welcome, <t t-out="object.name or ''">Employee</t>
                                </h1>
                                <p style="margin:0 0 14px 0;font-size:15px;line-height:1.6;color:#4A4A4A;">
                                    We are glad to have you with us at
                                    <strong style="color:#1A1A1A;"><t t-out="object.company_id.name or ''">the company</t></strong>.
                                    Your employee record has been created, and the details we hold
                                    for you are below.
                                </p>
                            </td>
                        </tr>

                        <!-- Details -->
                        <tr>
                            <td style="padding:8px 32px 4px 32px;">
                                <table cellpadding="0" cellspacing="0" border="0" width="100%"
                                       style="width:100%;border-collapse:collapse;border-left:3px solid #E4610F;background:#FDF6F1;">
                                    <tr>
                                        <td style="padding:8px 16px;font-size:12px;color:#8A6a55;width:150px;font-family:Arial,Helvetica,sans-serif;">Employee code</td>
                                        <td style="padding:8px 16px;font-size:14px;color:#1A1A1A;font-weight:bold;"><t t-out="object.employee_code or '-'">-</t></td>
                                    </tr>
                                    <tr>
                                        <td style="padding:8px 16px;font-size:12px;color:#8A6a55;font-family:Arial,Helvetica,sans-serif;">Job title</td>
                                        <td style="padding:8px 16px;font-size:14px;color:#1A1A1A;"><t t-out="object.job_title or '-'">-</t></td>
                                    </tr>
                                    <tr>
                                        <td style="padding:8px 16px;font-size:12px;color:#8A6a55;font-family:Arial,Helvetica,sans-serif;">Department</td>
                                        <td style="padding:8px 16px;font-size:14px;color:#1A1A1A;"><t t-out="object.department_id.name or '-'">-</t></td>
                                    </tr>
                                    <tr>
                                        <td style="padding:8px 16px;font-size:12px;color:#8A6a55;font-family:Arial,Helvetica,sans-serif;">Reporting to</td>
                                        <td style="padding:8px 16px;font-size:14px;color:#1A1A1A;"><t t-out="object.parent_id.name or '-'">-</t></td>
                                    </tr>
                                    <tr>
                                        <td style="padding:8px 16px;font-size:12px;color:#8A6a55;font-family:Arial,Helvetica,sans-serif;">Joining date</td>
                                        <td style="padding:8px 16px;font-size:14px;color:#1A1A1A;"><t t-out="object.joining_date or '-'">-</t></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                        <!-- Next steps -->
                        <tr>
                            <td style="padding:24px 32px 4px 32px;">
                                <p style="margin:0 0 10px 0;font-size:13px;letter-spacing:1.2px;text-transform:uppercase;color:#E4610F;font-weight:bold;font-family:Arial,Helvetica,sans-serif;">
                                    What happens next
                                </p>
                                <p style="margin:0 0 12px 0;font-size:15px;line-height:1.6;color:#4A4A4A;">
                                    HR will contact you about the documents we still need and walk
                                    you through your first days. If anything above is wrong, reply
                                    to this message and we will correct it.
                                </p>
                            </td>
                        </tr>

                        <!-- Sign-off -->
                        <tr>
                            <td style="padding:14px 32px 30px 32px;">
                                <p style="margin:0;font-size:15px;line-height:1.6;color:#4A4A4A;">
                                    Kind regards,<br/>
                                    <strong style="color:#1A1A1A;">HR Department</strong><br/>
                                    <t t-out="object.company_id.name or ''">Company</t>
                                </p>
                            </td>
                        </tr>

                        <!-- Footer -->
                        <tr>
                            <td style="background:#FDF6F1;border-top:2px solid #E4610F;padding:16px 32px;font-size:11px;line-height:1.6;color:#8A6a55;font-family:Arial,Helvetica,sans-serif;">
                                This message was sent to
                                <t t-out="object.work_email or ''">you</t>
                                because an employee record was created for you at
                                <t t-out="object.company_id.name or ''">the company</t>.
                            </td>
                        </tr>
                    </table>
                </div>
            </field>
        </record>
    </data>
</odoo>
