<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Probation evaluation form, answered by the direct manager through a
        token link (most managers have no login). noupdate, so HR can reword
        or add questions in Surveys without an upgrade undoing it.
        Scored 1-5 per criterion; the score shown on the employee is the
        survey's own percentage. The recommendation is not scored.
    -->
    <data noupdate="1">
        <record id="survey_probation_evaluation" model="survey.survey">
            <field name="title">Probation Period Evaluation / تقييم فترة الاختبار</field>
            <field name="survey_type">custom</field>
            <field name="access_mode">token</field>
            <field name="users_login_required" eval="False"/>
            <field name="users_can_go_back" eval="True"/>
            <field name="questions_layout">one_page</field>
            <field name="scoring_type">scoring_without_answers</field>
            <field name="scoring_success_min">60</field>
            <field name="is_hr_evaluation" eval="True"/>
            <field name="is_attempts_limited" eval="True"/>
            <field name="attempts_limit">1</field>
            <field name="description_done" type="html">
<p>Thank you. Your evaluation has been saved in the employee's file.</p>
<p dir="rtl">شكرًا لك، تم حفظ التقييم في ملف الموظف.</p></field>
            <field name="description" type="html">
<p>Please rate the employee for each criterion from 1 (poor) to 5 (outstanding), then give your recommendation.</p>
<p dir="rtl">برجاء تقييم الموظف في كل بند من 1 (ضعيف) إلى 5 (ممتاز)، ثم تحديد التوصية.</p></field>
        </record>

        <record id="probation_question_knowledge" model="survey.question">
            <field name="survey_id" ref="survey_probation_evaluation"/>
            <field name="sequence">1</field>
            <field name="title">Job knowledge and skills / المعرفة والمهارات الوظيفية</field>
            <field name="question_type">simple_choice</field>
            <field name="constr_mandatory" eval="True"/>
        </record>
        <record id="probation_question_knowledge_1" model="survey.question.answer">
            <field name="question_id" ref="probation_question_knowledge"/>
            <field name="sequence">1</field>
            <field name="value">1 - Poor / ضعيف</field>
            <field name="answer_score">1</field>
        </record>
        <record id="probation_question_knowledge_2" model="survey.question.answer">
            <field name="question_id" ref="probation_question_knowledge"/>
            <field name="sequence">2</field>
            <field name="value">2 - Below expectations / أقل من المتوقع</field>
            <field name="answer_score">2</field>
        </record>
        <record id="probation_question_knowledge_3" model="survey.question.answer">
            <field name="question_id" ref="probation_question_knowledge"/>
            <field name="sequence">3</field>
            <field name="value">3 - Meets expectations / يلبي المتوقع</field>
            <field name="answer_score">3</field>
        </record>
        <record id="probation_question_knowledge_4" model="survey.question.answer">
            <field name="question_id" ref="probation_question_knowledge"/>
            <field name="sequence">4</field>
            <field name="value">4 - Exceeds expectations / يفوق المتوقع</field>
            <field name="answer_score">4</field>
        </record>
        <record id="probation_question_knowledge_5" model="survey.question.answer">
            <field name="question_id" ref="probation_question_knowledge"/>
            <field name="sequence">5</field>
            <field name="value">5 - Outstanding / ممتاز</field>
            <field name="answer_score">5</field>
