<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_probation_evaluation" model="ir.cron">
            <field name="name">Employees: Send Probation Evaluations</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_probation_evaluations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Delay after joining before the manager is asked, and how long
             after that a joiner is still picked up automatically. -->
        <record id="config_probation_evaluation_days" model="ir.config_parameter">
            <field name="key">ellithy_hr.probation_evaluation_days</field>
            <field name="value">60</field>
        </record>
        <record id="config_probation_window_days" model="ir.config_parameter">
            <field name="key">ellithy_hr.probation_window_days</field>
            <field name="value">30</field>
        </record>
    </data>
</odoo>
