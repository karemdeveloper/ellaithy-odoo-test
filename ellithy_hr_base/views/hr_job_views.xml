<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_job_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.job.form.ellithy</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <field name="department_id" position="after">
                <field name="name_ar"/>
                <field name="section_id"/>
                <field name="is_kpi_locked"/>
                <field name="legacy_id" readonly="1" groups="base.group_no_one"/>
            </field>
        </field>
    </record>

    <record id="hr_job_view_list_inherit" model="ir.ui.view">
        <field name="name">hr.job.list.ellithy</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="name_ar" optional="show"/>
                <field name="section_id" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
