<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ellithy_branch_view_list" model="ir.ui.view">
        <field name="name">ellithy.branch.list</field>
        <field name="model">ellithy.branch</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="name_ar"/>
                <field name="code"/>
                <field name="manager_id"/>
                <field name="phone"/>
                <field name="employee_count" string="Employees"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="ellithy_branch_view_form" model="ir.ui.view">
        <field name="name">ellithy.branch.form</field>
        <field name="model">ellithy.branch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_employees" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="employee_count" widget="statinfo" string="Employees"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Branch name"/></h1>
                        <h2><field name="name_ar" placeholder="الاسم بالعربية"/></h2>
                    </div>
                    <group>
                        <group string="Details">
                            <field name="code"/>
                            <field name="manager_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Contact">
                            <field name="address"/>
                            <field name="phone"/>
                        </group>
                        <group string="Location"
                               help="Required in the legacy system. Combined with NFC/QR check-in these coordinates support geofenced attendance.">
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                        <!-- <group string="Migration">
                            <field name="legacy_id" readonly="1"/>
                        </group> -->
                    </group>
                    <notebook>
                        <page string="Departments" name="departments">
                            <field name="department_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="name_ar"/>
                                    <field name="dept_type"/>
                                    <field name="manager_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ellithy_branch_view_search" model="ir.ui.view">
        <field name="name">ellithy.branch.search</field>
        <field name="model">ellithy.branch</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('name_ar', 'ilike', self)]"/>
                <field name="manager_id"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ellithy_branch_action" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">ellithy.branch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
