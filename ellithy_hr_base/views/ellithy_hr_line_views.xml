<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ellithy_hr_line_view_list" model="ir.ui.view">
        <field name="name">ellithy.hr.line.list</field>
        <field name="model">ellithy.hr.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="number"/>
                <field name="line_type"/>
                <field name="holder_type" column_invisible="1"/>
                <field name="employee_id" optional="show"
                       column_invisible="context.get('hide_employee')"/>
                <field name="department_id" optional="show"
                       column_invisible="context.get('hide_department')"/>
                <field name="section_id" optional="show"
                       column_invisible="context.get('hide_section')"/>
                <field name="branch_id" optional="hide"/>
                <field name="serial"/>
                <field name="bundle"/>
            </list>
        </field>
    </record>

    <record id="ellithy_hr_line_view_form" model="ir.ui.view">
        <field name="name">ellithy.hr.line.form</field>
        <field name="model">ellithy.hr.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="number"/>
                        <h1><field name="number" placeholder="Number"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="line_type"/>
                            <field name="holder_type" invisible="1"/>
                            <field name="employee_id"
                                   invisible="holder_type != 'employee'"/>
                            <field name="department_id"
                                   invisible="holder_type != 'department'"/>
                            <field name="section_id"
                                   invisible="holder_type != 'section'"/>
                            <field name="branch_id"
                                   invisible="holder_type != 'employee'"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="serial"/>
                            <field name="bundle"/>
                            <field name="legacy_id" readonly="1"
                                   groups="base.group_no_one"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ellithy_hr_line_view_search" model="ir.ui.view">
        <field name="name">ellithy.hr.line.search</field>
        <field name="model">ellithy.hr.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="number"/>
                <field name="serial"/>
                <field name="bundle"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <filter name="f_unassigned" string="Unassigned"
                        domain="[('employee_id','=',False),('department_id','=',False),('section_id','=',False)]"/>
                <filter name="f_archived" string="Archived"
                        domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter name="g_type" string="Type"
                            context="{'group_by': 'line_type'}"/>
                    <filter name="g_bundle" string="Bundle"
                            context="{'group_by': 'bundle'}"/>
                    <filter name="g_employee" string="Employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="g_branch" string="Branch"
                            context="{'group_by': 'branch_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ellithy_hr_line_action_phone" model="ir.actions.act_window">
        <field name="name">Work Numbers</field>
        <field name="res_model">ellithy.hr.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('line_type', '=', 'phone')]</field>
        <field name="context">{'default_line_type': 'phone', 'hide_department': True, 'hide_section': True}</field>
    </record>

    <record id="ellithy_hr_line_action_lap" model="ir.actions.act_window">
        <field name="name">Lap Numbers</field>
        <field name="res_model">ellithy.hr.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('line_type', '=', 'lap')]</field>
        <field name="context">{'default_line_type': 'lap', 'hide_department': True, 'hide_section': True}</field>
    </record>

    <record id="ellithy_hr_line_action_adsl" model="ir.actions.act_window">
        <field name="name">ADSL Numbers</field>
        <field name="res_model">ellithy.hr.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('line_type', '=', 'adsl')]</field>
        <field name="context">{'default_line_type': 'adsl', 'hide_employee': True, 'hide_section': True}</field>
    </record>

    <record id="ellithy_hr_line_action_sms" model="ir.actions.act_window">
        <field name="name">SMS Numbers</field>
        <field name="res_model">ellithy.hr.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('line_type', '=', 'sms')]</field>
        <field name="context">{'default_line_type': 'sms', 'hide_employee': True, 'hide_section': True}</field>
    </record>

    <record id="ellithy_hr_line_action_data" model="ir.actions.act_window">
        <field name="name">Data Numbers</field>
        <field name="res_model">ellithy.hr.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('line_type', '=', 'data')]</field>
        <field name="context">{'default_line_type': 'data', 'hide_employee': True, 'hide_department': True}</field>
    </record>

    <record id="ellithy_hr_line_action_all" model="ir.actions.act_window">
        <field name="name">All Lines</field>
        <field name="res_model">ellithy.hr.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
