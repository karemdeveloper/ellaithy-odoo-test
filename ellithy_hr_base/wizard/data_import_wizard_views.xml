<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ellithy_data_import_wizard_view_form" model="ir.ui.view">
        <field name="name">ellithy.data.import.wizard.form</field>
        <field name="model">ellithy.data.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Data Upload">
                <div class="alert alert-info" role="status">
                    Choose what you are uploading. The next screen reads your Excel or
                    CSV file, matches its columns, and its <b>Test</b> button lists every
                    row with a problem before anything is saved.
                </div>
                <group>
                    <field name="data_type" widget="radio"/>
                    <field name="columns_help" readonly="1"/>
                </group>
                <footer>
                    <button name="action_open_import" type="object" string="Continue"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ellithy_data_import" model="ir.actions.act_window">
        <field name="name">Data Upload</field>
        <field name="res_model">ellithy.data.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_data_import" name="Data Upload"
              parent="hr.menu_human_resources_configuration"
              action="action_ellithy_data_import" sequence="5"
              groups="ellithy_hr_base.group_ellithy_hr_admin"/>
</odoo>
